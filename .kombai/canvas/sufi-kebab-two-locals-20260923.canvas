      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n\n.kp-display { font-family: 'Barlow Condensed', Impact, sans-serif; }\n.kp-mono { font-family: 'IBM Plex Mono', 'Courier New', monospace; }\n.kp-ui { font-family: 'Space Grotesk', Arial, sans-serif; }\n.kp-serif-rule { position: relative; }\n.kp-serif-rule::after { content: ''; display: block; width: 72px; height: 3px; margin-top: 18px; background: #edb728; }\n.kp-mark-rule { height: 1px; background: #a82e23; }\n.kp-focus:focus-visible { outline: 3px solid #edb728; outline-offset: 4px; }\n.kp-service-card:has(input:checked), .kp-local-plate:has(input:checked) { border-color: #edb728; background: #1b1a16; }\n.kp-service-card:has(input:checked) .kp-check, .kp-local-plate:has(input:checked) .kp-check { opacity: 1; transform: scale(1); }\n.kp-service-card:has(input:checked) .kp-service-line { background: #edb728; }\n.kp-service-card, .kp-local-plate, .kp-contact-row { transition: border-color 180ms ease, background-color 180ms ease, color 180ms ease; }\n.kp-service-card:hover, .kp-local-plate:hover, .kp-contact-row:hover { border-color: #e05a4f; }\n.kp-price-row:last-child { border-bottom: 0; }\n@media (max-width: 760px) {\n  .kp-hero-title { font-size: clamp(4.4rem, 19vw, 7rem); }\n  .kp-section-title { font-size: clamp(3.6rem, 16vw, 6rem); }\n}\n</style>\n<link data-kid=\"2\" data-name=\"tabler icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"kp-ui min-h-screen overflow-x-hidden bg-[#0a0a09] text-[#f0eee8] selection:bg-[#edb728] selection:text-[#0a0a09]\" data-kid=\"1\">\n    <header class=\"border-b border-[#f0eee8]/15 bg-[#0a0a09]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex min-h-[76px] w-[min(100%-40px,1180px)] items-center justify-between gap-6 py-4 sm:min-h-[84px] sm:w-[min(100%-64px,1180px)]\" data-kid=\"1-1-1\">\n            <a aria-label=\"SUFI KEBAB, volver al inicio\" class=\"kp-focus inline-flex min-h-[44px] items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#inicio\">\n                <span class=\"kp-display text-[2rem] font-extrabold leading-[.72] tracking-[-.04em] text-[#f0eee8] sm:text-[2.55rem]\" data-kid=\"1-1-1-1-1\">\n                    SUFI\n                </span>\n                <span class=\"h-8 w-px bg-[#a82e23]\" data-kid=\"1-1-1-1-2\">\n                </span>\n                <span class=\"kp-display text-[2rem] font-extrabold leading-[.72] tracking-[-.04em] text-[#e05a4f] sm:text-[2.55rem]\" data-kid=\"1-1-1-1-3\">\n                    KEBAB\n                </span>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"hidden items-center gap-7 text-[10px] font-semibold uppercase tracking-[.16em] text-[#f0eee8]/70 md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"kp-focus py-3 hover:text-[#edb728]\" data-kid=\"1-1-1-2-1\" href=\"#locales\">\n                    Elegir local\n                </a>\n                <a class=\"kp-focus py-3 hover:text-[#edb728]\" data-kid=\"1-1-1-2-2\" href=\"#sale-ahora\">\n                    Sale ahora\n                </a>\n                <a class=\"kp-focus py-3 hover:text-[#edb728]\" data-kid=\"1-1-1-2-3\" href=\"#servicios\">\n                    Servicios\n                </a>\n                <a class=\"kp-focus border border-[#f0eee8]/30 px-4 py-3 text-[#f0eee8] hover:border-[#edb728] hover:text-[#edb728]\" data-kid=\"1-1-1-2-4\" href=\"#contacto\">\n                    Contacto\n                </a>\n            </nav>\n            <a class=\"kp-focus inline-flex min-h-[44px] items-center justify-center border border-[#edb728] px-3 text-[10px] font-semibold uppercase tracking-[.14em] text-[#edb728] hover:bg-[#edb728] hover:text-[#0a0a09] md:hidden\" data-kid=\"1-1-1-3\" href=\"#locales\">\n                Elegir local\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"inicio\">\n        <section aria-labelledby=\"hero-title\" class=\"mx-auto w-[min(100%-40px,1180px)] pb-20 pt-12 sm:w-[min(100%-64px,1180px)] sm:pb-28 sm:pt-20 lg:pb-32 lg:pt-24\" data-kid=\"1-2-1\">\n            <div class=\"grid items-start gap-12 lg:grid-cols-[minmax(0,1.02fr)_minmax(360px,.98fr)] lg:gap-20\" data-kid=\"1-2-1-1\">\n                <div data-kid=\"1-2-1-1-1\">\n                    <p class=\"kp-mono mb-5 text-[10px] font-semibold uppercase tracking-[.28em] text-[#e05a4f]\" data-kid=\"1-2-1-1-1-1\">\n                        SUFI KEBAB · EL PASE DE COCINA\n                    </p>\n                    <h1 class=\"kp-display kp-hero-title max-w-[720px] text-[6.5rem] font-extrabold uppercase leading-[.78] tracking-[-.045em] text-[#f0eee8] sm:text-[8.8rem] lg:text-[9.8rem]\" data-kid=\"1-2-1-1-1-2\" id=\"hero-title\">\n                        SUFI KEBAB,\n                        <br data-kid=\"1-2-1-1-1-2-1\"/>\n                        <span class=\"text-[#e05a4f]\" data-kid=\"1-2-1-1-1-2-2\">\n                            AL FUEGO.\n                        </span>\n                    </h1>\n                    <p class=\"mt-9 max-w-[530px] text-[1.1rem] leading-8 text-[#f0eee8]/72 sm:text-[1.2rem]\" data-kid=\"1-2-1-1-1-3\">\n                        Elige cómo lo quieres. Después selecciona tu local y te enseñamos la forma correcta de contactar.\n                    </p>\n                    <fieldset aria-describedby=\"service-help\" class=\"mt-10 max-w-[690px]\" data-kid=\"1-2-1-1-1-4\">\n                        <legend class=\"kp-mono mb-4 text-[11px] font-semibold uppercase tracking-[.18em] text-[#edb728]\" data-kid=\"1-2-1-1-1-4-1\">\n                            ¿Cómo lo quieres?\n                        </legend>\n                        <div class=\"grid gap-3 sm:grid-cols-3\" data-kid=\"1-2-1-1-1-4-2\">\n                            <label class=\"kp-focus 