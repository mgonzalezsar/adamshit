ono whitespace-nowrap text-[10px] uppercase tracking-[.1em] text-[#edb728]\" data-kid=\"1-2-6-1-1-2-1-1-2\">\n                                    Por confirmar\n                                </span>\n                            </div>\n                            <div class=\"flex min-h-[88px] items-start justify-between gap-5 border-b border-[#f0eee8]/15 py-5\" data-kid=\"1-2-6-1-1-2-1-2\">\n                                <div class=\"flex gap-5\" data-kid=\"1-2-6-1-1-2-1-2-1\">\n                                    <span class=\"kp-mono text-[11px] font-semibold text-[#e05a4f]\" data-kid=\"1-2-6-1-1-2-1-2-1-1\">\n                                        02\n                                    </span>\n                                    <div data-kid=\"1-2-6-1-1-2-1-2-1-2\">\n                                        <h3 class=\"kp-display text-3xl font-bold uppercase leading-none text-[#f0eee8]\" data-kid=\"1-2-6-1-1-2-1-2-1-2-1\">\n                                            Recoger\n                                        </h3>\n                                        <p class=\"kp-mono mt-2 text-[10px] uppercase tracking-[.08em] text-[#f0eee8]/50\" data-kid=\"1-2-6-1-1-2-1-2-1-2-2\">\n                                            Consulta disponibilidad al elegir local\n                                        </p>\n                                    </div>\n                                </div>\n                                <span class=\"kp-mono whitespace-nowrap text-[10px] uppercase tracking-[.1em] text-[#edb728]\" data-kid=\"1-2-6-1-1-2-1-2-2\">\n                                    Por confirmar\n                                </span>\n                            </div>\n                            <div class=\"flex min-h-[88px] items-start justify-between gap-5 py-5\" data-kid=\"1-2-6-1-1-2-1-3\">\n                                <div class=\"flex gap-5\" data-kid=\"1-2-6-1-1-2-1-3-1\">\n                                    <span class=\"kp-mono text-[11px] font-semibold text-[#e05a4f]\" data-kid=\"1-2-6-1-1-2-1-3-1-1\">\n                                        03\n                                    </span>\n                                    <div data-kid=\"1-2-6-1-1-2-1-3-1-2\">\n                                        <h3 class=\"kp-display text-3xl font-bold uppercase leading-none text-[#f0eee8]\" data-kid=\"1-2-6-1-1-2-1-3-1-2-1\">\n                                            A domicilio\n                                        </h3>\n                                        <p class=\"kp-mono mt-2 text-[10px] uppercase tracking-[.08em] text-[#f0eee8]/50\" data-kid=\"1-2-6-1-1-2-1-3-1-2-2\">\n                                            Consulta disponibilidad al elegir local\n                                        </p>\n                                    </div>\n                                </div>\n                                <span class=\"kp-mono whitespace-nowrap text-[10px] uppercase tracking-[.1em] text-[#edb728]\" data-kid=\"1-2-6-1-1-2-1-3-2\">\n                                    Por confirmar\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"trust-title\" class=\"bg-[#a82e23] text-[#f0eee8]\" data-kid=\"1-2-7\">\n            <div class=\"mx-auto w-[min(100%-40px,1180px)] py-16 sm:w-[min(100%-64px,1180px)] sm:py-20\" data-kid=\"1-2-7-1\">\n                <div class=\"grid gap-10 md:grid-cols-[1fr_auto_1fr] md:items-end md:gap-12\" data-kid=\"1-2-7-1-1\">\n                    <div data-kid=\"1-2-7-1-1-1\">\n                        <p class=\"kp-mono mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-[#f0eee8]/70\" data-kid=\"1-2-7-1-1-1-1\">\n                            Lo que comunica la identidad\n                        </p>\n                        <h2 class=\"kp-display text-[4.8rem] font-extrabold uppercase leading-[.78] tracking-[-.04em] sm:text-[6.7rem]\" data-kid=\"1-2-7-1-1-1-2\" id=\"trust-title\">\n                            Halal\n                            <br data-kid=\"1-2-7-1-1-1-2-1\"/>\n                            <span class=\"text-[#edb728]\" data-kid=\"1-2-7-1-1-1-2-2\">\n                                100%.\n                            </span>\n                        </h2>\n                    </div>\n                    <div class=\"hidden h-24 w-px bg-[#f0eee8]/35 md:block\" data-kid=\"1-2-7-1-1-2\">\n                    </div>\n                    <div class=\"md:text-right\" data-kid=\"1-2-7-1-1-3\">\n                        <p class=\"kp-mono mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-[#f0eee8]/70\" data-kid=\"1-2-7-1-1-3-1\">\n                            Directo del pase\n                        </p>\n                        <p class=\"kp-display text-[4.8rem] font-extrabold uppercase leading-[.78] tracking-[-.04em] sm:text-[6.7rem]\" data-kid=\"1-2-7-1-1-3-2\">\n                            Carne\n                            <br data-kid=\"1-2-7-1-1-3-2-1\"/>\n                            <span class=\"text-[#edb728]\" data-kid=\"1-2-7-1-1-3-2-2\">\n                                de calidad.\n                            </span>\n                        </p>\n                    </div>\n                </div>\n                <p class=\"kp-mono mt-10 max-w-[760px] border-t border-[#f0eee8]/25 pt-5 text-[10px] uppercase leading-6 tracking-[.05em] text-[#f0eee8]/75\" data-kid=\"1-2-7-1-2\">\n                    Mensajes presentes en el material de marca facilitado. La validación documental y el alcance de cada declaración quedan pendientes de confirmación.\n                </p>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"mx-auto w-[min(100%-40px,1180px)] py-20 sm:w-[min(100%-64px,1180px)] sm:py-28\" data-kid=\"1-2-8\" id=\"contacto\">\n            <div class=\"grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-20\" data-kid=\"1-2-8-1\">\n                <div data-kid=\"1-2-8-1-1\">\n                    <p class=\"kp-mono mb-4 text-[10px] font-semibold uppercase tracking-[.2em] text-[#e05a4f]\" data-kid=\"1-2-8-1-1-1\">\n                        04 · Contacto final\n                    </p>\n                    <h2 class=\"kp-display kp-section-title text-[5.3rem] font-extrabold uppercase leading-[.78] tracking-[-.04em] text-[#f0eee8]\" data-kid=\"1-2-8-1-1-2\" id=\"contact-title\">\n                        Ya sabes\n                        <br data-kid=\"1-2-8-1-1-2-1\"/>\n                        <span class=\"text-[#edb728]\" data-kid=\"1-2-8-1-1-2-2\">\n                            cómo lo quieres.\n                        </span>\n                    </h2>\n                    <p class=\"mt-8 max-w-[420px] text-[1rem] leading-7 text-[#f0eee8]/64\" data-kid=\"1-2-8-1-1-3\">\n                        Selecciona un local para que podamos mostrar sus vías reales de contacto. No hay enlaces vacíos ni números inventados.\n                    </p>\n                </div>\n                <div data-kid=\"1-2-8-1-2\">\n                    <div class=\"border-y border-[#edb728] py-5\" data-kid=\"1-2-8-1-2-1\">\n                        <p class=\"kp-mono text-[10px] uppercase tracking-[.16em] text-[#f0eee8]/52\" data-kid=\"1-2-8-1-2-1-1\">\n                            Resumen de selección\n                        </p>\n                        <p class=\"mt-2 text-xl text-[#f0eee8]\" data-kid=\"1-2-8-1-2-1-2\">\n                            <span data-dynamic=\"true\" data-kid=\"1-2-8-1-2-1-2-1\" data-name=\"contact service name\" data-reason=\"text updated via JS when service radio changes\" id=\"contact-service\">\n                                Recoger\n                            </span>\n                            <span class=\"text-[#e05a4f]\" data-kid=\"1-2-8-1-2-1-2-2\">\n                                ·\n                            </span>\n                            <span data-dynamic=\"true\" data-kid=\"1-2-8-1-2-1-2-3\" data-name=\"contact local name\" data-reason=\"text updated via JS when local radio changes\" id=\"contact-local\">\n                                Local 01\n                            </span>\n                        </p>\n                    </div>\n                    <div class=\"mt-4 grid gap-3\" data-kid=\"1-2-8-1-2-2\">\n                        <button class=\"kp-focus kp-contact-row flex min-h-[58px] w-full cursor-not-allowed items-center justify-between border border-[#f0eee8]/18 bg-[#151513] px-5 text-left\" data-kid=\"1-2-8-1-2-2-1\" disabled=\"\" type=\"button\">\n                            <span class=\"flex items-center gap-4\" data-kid=\"1-2-8-1-2-2-1-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-phone inline-flex h-[20px] w-[20px] items-center justify-center text-[20px] leading-none text-[#e05a4f]\" data-kid=\"1-2-8-1-2-2-1-1-1\">\n                                </i>\n                                <span class=\"font-semibold\" data-kid=\"1-2-8-1-2-2-1-1-2\">\n                                    Llamar al local\n                                </span>\n                            </span>\n                            <span class=\"kp-mono text-[10px] uppercase tracking-[.08em] text-[#f0eee8]/48\" data-kid=\"1-2-8-1-2-2-1-2\">\n                                Pendiente de confirmar\n                            </span>\n                        </button>\n                        <button class=\"kp-focus kp-contact-row flex min-h-[58px] w-full cursor-not-allowed items-center justify-between border border-[#f0eee8]/18 bg-[#151513] px-5 text-left\" data-kid=\"1-2-8-1-2-2-2\" disabled=\"\" type=\"button\">\n                            <span class=\"flex items-center gap-4\" data-kid=\"1-2-8-1-2-2-2-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp inline-flex h-[20px] w-[20px] items-center justify-center text-[20px] leading-none text-[#e05a4f]\" data-kid=\"1-2-8-1-2-2-2-1-1\">\n                                </i>\n                                <span class=\"font-semibold\" data-kid=\"1-2-8-1-2-2-2-1-2\">\n                                    Escribir por WhatsApp\n                                </span>\n                            </span>\n                            <span class=\"kp-mono text-[10px] uppercase tracking-[.08em] text-[#f0eee8]/48\" data-kid=\"1-2-8-1-2-2-2-2\">\n                                En preparación\n                            </span>\n                        </button>\n                        <button class=\"kp-focus kp-contact-row flex min-h-[58px] w-full cursor-not-allowed items-center justify-between border border-[#f0eee8]/18 bg-[#151513] px-5 text-left\" data-kid=\"1-2-8-1-2-2-3\" disabled=\"\" type=\"button\">\n                            <span class=\"flex items-center gap-4\" data-kid=\"1-2-8-1-2-2-3-1\">\n                                <i aria-hidden=\"true\" class=\"ti ti-map-pin inline-flex h-[20px] w-[20px] items-center justify-center text-[20px] leading-none text-[#e05a4f]\" data-kid=\"1-2-8-1-2-2-3-1-1\">\n                                </i>\n                                <span class=\"font-semibold\" data-kid=\"1-2-8-1-2-2-3-1-2\">\n                                    Abrir en Maps\n                                </span>\n                            </span>\n                            <span class=\"kp-mono text-[10px] uppercase tracking-[.08em] text-[#f0eee8]/48\" data-kid=\"1-2-8-1-2-2-3-2\">\n                                En preparación\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[#f0eee8]/15 bg-[#151513]\" data-kid=\"1-3\">\n        <div class=\"mx-auto grid w-[min(100%-40px,1180px)] gap-10 py-12 sm:w-[min(100%-64px,1180px)] sm:grid-cols-[1.1fr_1fr_auto] sm:items-end\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"kp-display text-5xl font-extrabold uppercase leading-[.75] tracking-[-.04em] text-[#f0eee8]\" data-kid=\"1-3-1-1-1\">\n                    SUFI\n                    <br data-kid=\"1-3-1-1-1-1\"/>\n                    <span class=\"text-[#e05a4f]\" data-kid=\"1-3-1-1-1-2\">\n                        KEBAB.\n                    </span>\n                </p>\n                <p class=\"mt-6 max-w-[260px] text-sm leading-6 text-[#f0eee8]/55\" data-kid=\"1-3-1-1-2\">\n                    Dos locales · una misma identidad · información verificada antes de publicar.\n                </p>\n            </div>\n            <nav aria-label=\"Enlaces del pie\" class=\"kp-mono grid gap-3 text-[10px] uppercase tracking-[.1em] text-[#f0eee8]/60\" data-kid=\"1-3-1-2\">\n                <a class=\"kp-focus py-2 hover:text-[#edb728]\" data-kid=\"1-3-1-2-1\" href=\"#locales\">\n                    Elegir local\n                </a>\n                <a class=\"kp-focus py-2 hover:text-[#edb728]\" data-kid=\"1-3-1-2-2\" href=\"#sale-ahora\">\n                    Destacados\n                </a>\n                <a class=\"kp-focus py-2 hover:text-[#edb728]\" data-kid=\"1-3-1-2-3\" href=\"#servicios\">\n                    Servicios\n                </a>\n            </nav>\n            <p class=\"kp-mono m-0 text-[10px] uppercase leading-5 tracking-[.08em] text-[#f0eee8]/45 sm:text-right\" data-kid=\"1-3-1-3\">\n                Carta completa\n                <br data-kid=\"1-3-1-3-1\"/>\n                próximamente\n            </p>\n        </div>\n        <div class=\"mx-auto flex w-[min(100%-40px,1180px)] justify-between gap-4 border-t border-[#f0eee8]/12 py-5 sm:w-[min(100%-64px,1180px)]\" data-kid=\"1-3-2\">\n            <span class=\"kp-mono text-[9px] uppercase tracking-[.1em] text-[#f0eee8]/42\" data-kid=\"1-3-2-1\">\n                SUFI KEBAB · 2026\n            </span>\n            <span class=\"kp-mono text-[9px] uppercase tracking-[.1em] text-[#f0eee8]/42\" data-kid=\"1-3-2-2\">\n                Datos por confirmar\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    const serviceLive = document.querySelector('#service-live');\n  const serviceSummary = document.querySelector('#summary-service');\n  const contactService = document.querySelector('#contact-service');\n  const localLive = document.querySelector('#local-live');\n  const localSummary = document.querySelector('#summary-local');\n  const contactLocal = document.querySelector('#contact-local');\n  document.querySelectorAll('[data-service]').forEach((input) => input.addEventListener('change', () => {\n    const label = input.dataset.service;\n    serviceLive.textContent = label;\n    serviceSummary.textContent = label;\n    contactService.textContent = label;\n  }));\n  document.querySelectorAll('[data-local]').forEach((input) => input.addEventListener('change', () => {\n    const label = input.dataset.local;\n    localLive.textContent = `${label} seleccionado. Datos de contacto pendientes de confirmar.`;\n    localSummary.textContent = label;\n    contactLocal.textContent = label;\n  }));\n</script>\n",
      "comments": [],
      "created": "2026-09-23T06:53:22.225592+00:00",
