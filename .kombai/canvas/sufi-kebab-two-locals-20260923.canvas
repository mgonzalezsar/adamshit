    },
    "var_e0be0d1daa75": {
      "type": "variant",
      "label": "SUFI KEBAB · Local-first editorial",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --ink: #0a0a09;\n    --panel: #151513;\n    --panel-2: #1b1a16;\n    --ivory: #f0eee8;\n    --muted: #a3a097;\n    --line: rgba(240,238,232,.16);\n    --line-soft: rgba(240,238,232,.09);\n    --yellow: #edb728;\n    --red: #a82e23;\n    --red-light: #e05a4f;\n    --display: 'Barlow Condensed', Impact, sans-serif;\n    --mono: 'IBM Plex Mono', 'Courier New', monospace;\n    --ui: 'Space Grotesk', Arial, sans-serif;\n  }\n  html { scroll-behavior: smooth; background: var(--ink); }\n  body { min-width: 0; margin: 0; overflow-x: hidden; background: var(--ink); color: var(--ivory); font-family: var(--ui); }\n  .su-display { font-family: var(--display); letter-spacing: -.035em; }\n  .su-mono { font-family: var(--mono); }\n  .su-rule { background: linear-gradient(90deg, var(--red) 0 72%, transparent 72% 78%, var(--red) 78% 100%); }\n  .su-card-rule { background: linear-gradient(90deg, var(--yellow) 0 38%, transparent 38% 44%, var(--red) 44% 100%); }\n  .su-noise { background-image: radial-gradient(circle at 20% 20%, rgba(240,238,232,.045) 0 1px, transparent 1.5px); background-size: 18px 18px; }\n  @media (min-width: 768px) {\n    .su-hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(300px, .9fr); }\n    .su-feature-grid { grid-template-columns: minmax(180px, .75fr) minmax(300px, 1.45fr) minmax(220px, .85fr); }\n  }\n  @media (max-width: 767px) {\n    .su-tight-mobile { letter-spacing: -.045em; }\n  }\n</style>\n<div class=\"min-h-screen overflow-x-hidden bg-[var(--ink)] text-[var(--ivory)]\" data-kid=\"1\">\n    <header class=\"border-b border-[var(--line-soft)] bg-[var(--ink)]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex min-h-[72px] max-w-[1180px] items-center justify-between gap-5 px-5 md:px-8\" data-kid=\"1-1-1\">\n            <a aria-label=\"SUFI KEBAB, inicio\" class=\"flex items-center gap-3\" data-kid=\"1-1-1-1\" href=\"#inicio\">\n                <span class=\"su-display text-[30px] font-extrabold leading-none tracking-[-.04em] text-[var(--ivory)]\" data-kid=\"1-1-1-1-1\">\n                    SUFI\n                    <span class=\"text-[var(--red-light)]\" data-kid=\"1-1-1-1-1-1\">\n                        KEBAB\n                    </span>\n                </span>\n                <span class=\"hidden border-l border-[var(--line)] pl-3 text-[9px] uppercase tracking-[.24em] text-[var(--muted)] sm:inline su-mono\" data-kid=\"1-1-1-1-2\">\n                    dos locales\n                </span>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"hidden items-center gap-7 text-[10px] font-semibold uppercase tracking-[.14em] text-[var(--muted)] md:flex\" data-kid=\"1-1-1-2\">\n                <a class=\"min-h-[44px] py-3 leading-[20px] transition-colors hover:text-[var(--yellow)]\" data-kid=\"1-1-1-2-1\" href=\"#locales\">\n                    Locales\n                </a>\n                <a class=\"min-h-[44px] py-3 leading-[20px] transition-colors hover:text-[var(--yellow)]\" data-kid=\"1-1-1-2-2\" href=\"#destacados\">\n                    Destacados\n                </a>\n                <a class=\"min-h-[44px] py-3 leading-[20px] transition-colors hover:text-[var(--yellow)]\" data-kid=\"1-1-1-2-3\" href=\"#servicios\">\n                    Servicios\n                </a>\n            </nav>\n            <a class=\"flex min-h-[44px] items-center border border-[var(--yellow)] px-4 text-[10px] font-bold uppercase tracking-[.1em] text-[var(--yellow)] transition-colors hover:bg-[var(--yellow)] hover:text-[var(--ink)]\" data-kid=\"1-1-1-3\" href=\"#locales\">\n                Elegir local\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"inicio\">\n        <section aria-labelledby=\"hero-title\" class=\"relative border-b border-[var(--line-soft)]\" data-kid=\"1-2-1\">\n            <div class=\"mx-auto grid max-w-[1180px] gap-10 px-5 py-12 md:gap-14 md:px-8 md:py-16 su-hero-grid\" data-kid=\"1-2-1-1\">\n                <div class=\"flex flex-col justify-center\" data-kid=\"1-2-1-1-1\">\n                    <div class=\"mb-7 flex items-center gap-3 text-[10px] uppercase tracking-[.24em] text-[var(--red-light)] su-mono\" data-kid=\"1-2-1-1-1-1\">\n                        <span class=\"h-px w-9 bg-[var(--red)]\" data-kid=\"1-2-1-1-1-1-1\">\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-1-2\">\n                            Comida al fuego · SUFI KEBAB\n                        </span>\n                    </div>\n                    <h1 class=\"su-display su-tight-mobile max-w-[720px] text-[76px] font-extrabold uppercase leading-[.78] text-[var(--ivory)] sm:text-[100px] md:text-[124px]\" data-kid=\"1-2-1-1-1-2\" id=\"hero-title\">\n                        Elige\n                        <br data-kid=\"1-2-1-1-1-2-1\"/>\n                        <span class=\"text-[var(--red-light)]\" data-kid=\"1-2-1-1-1-2-2\">\n                            tu local.\n                        </span>\n                    </h1>\n                    <p class=\"mt-8 max-w-[520px] text-[17px] leading-7 text-[var(--muted)] md:text-[19px]\" data-kid=\"1-2-1-1-1-3\">\n                        Un solo fuego, dos puntos de encuentro. Selecciona tu SUFI para consultar cómo contactar, llegar o pedir cuando los datos estén confirmados.\n                    </p>\n                    <div class=\"mt-8 flex items-center gap-3 text-[10px] uppercase tracking-[.16em] text-[var(--yellow)] su-mono\" data-kid=\"1-2-1-1-1-4\">\n                        <span class=\"h-2 w-2 rounded-full bg-[var(--yellow)]\" data-kid=\"1-2-1-1-1-4-1\">\n                        </span>\n                        <span data-kid=\"1-2-1-1-1-4-2\">\n                            Halal · carne de calidad · sabor al fuego\n                        </span>\n                    </div>\n                </div>\n                <div class=\"relative flex min-h-[500px] flex-col justify-end overflow-hidden border border-[var(--line)] bg-[var(--panel)] p-5 md:min-h-[560px] md:p-7\" data-kid=\"1-2-1-1-2\">\n                    <img alt=\"Brasas encendidas en primer plano, fotografía de Natalia Tabarez en Unsplash\" class=\"absolute inset-0 h-full w-full object-cover opacity-50\" data-kid=\"1-2-1-1-2-1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1621034817184-4c667b132f92?auto=format&w=900&q=80&fit=crop\"/>\n                    <div class=\"absolute inset-0 bg-[linear-gradient(180deg,rgba(10,10,9,.18)_0%,rgba(10,10,9,.92)_72%,#0a0a09_100%)]\" data-kid=\"1-2-1-1-2-2\">\n                    </div>\n                    <div class=\"relative z-10\" data-kid=\"1-2-1-1-2-3\">\n                        <div class=\"mb-5 flex items-center justify-between border-b border-[var(--line)] pb-4\" data-kid=\"1-2-1-1-2-3-1\">\n                            <p class=\"m-0 text-[10px] font-semibold uppercase tracking-[.2em] text-[var(--yellow)] su-mono\" data-kid=\"1-2-1-1-2-3-1-1\">\n                                Selección de local\n                            </p>\n                            <span class=\"text-[10px] uppercase tracking-[.15em] text-[var(--muted)] su-mono\" data-kid=\"1-2-1-1-2-3-1-2\">\n                                01 / 02\n                            </span>\n                        </div>\n                        <fieldset class=\"m-0 border-0 p-0\" data-kid=\"1-2-1-1-2-3-2\" id=\"locales\">\n                            <legend class=\"mb-4 text-[24px] font-semibold leading-tight text-[var(--ivory)]\" data-kid=\"1-2-1-1-2-3-2-1\">\n                                ¿A qué local quieres ir?\n                            </legend>\n                            <div cla