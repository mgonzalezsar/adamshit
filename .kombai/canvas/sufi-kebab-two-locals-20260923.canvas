tle\" class=\"hero\" data-kid=\"1-2-1\">\n            <div class=\"sufi-container\" data-kid=\"1-2-1-1\">\n                <div class=\"hero__intro\" data-kid=\"1-2-1-1-1\">\n                    <div data-kid=\"1-2-1-1-1-1\">\n                        <p class=\"eyebrow\" data-kid=\"1-2-1-1-1-1-1\">\n                            SUFI KEBAB · IDENTIDAD EN PREPARACIÓN\n                        </p>\n                        <h1 data-kid=\"1-2-1-1-1-1-2\" id=\"hero-title\">\n                            Dos locales.\n                            <br data-kid=\"1-2-1-1-1-1-2-1\"/>\n                            <span data-kid=\"1-2-1-1-1-1-2-2\">\n                                Un solo\n                            </span>\n                            <br data-kid=\"1-2-1-1-1-1-2-3\"/>\n                            fuego.\n                        </h1>\n                        <p class=\"hero__lead\" data-kid=\"1-2-1-1-1-1-3\">\n                            Elige tu SUFI para consultar la carta de trabajo y activar las formas de contacto de la tienda correcta.\n                        </p>\n                    </div>\n                    <div class=\"hero__aside\" data-kid=\"1-2-1-1-1-2\">\n                        <p data-kid=\"1-2-1-1-1-2-1\">\n                            Del cartel\n                            <br data-kid=\"1-2-1-1-1-2-1-1\"/>\n                            al plato.\n                        </p>\n                        <small data-kid=\"1-2-1-1-1-2-2\">\n                            Halal · carne de calidad · sabor al fuego\n                            <br data-kid=\"1-2-1-1-1-2-2-1\"/>\n                            Información de sede pendiente de confirmación.\n                        </small>\n                    </div>\n                </div>\n                <div class=\"venue-heading\" data-kid=\"1-2-1-1-2\" id=\"locales\">\n                    <h2 data-kid=\"1-2-1-1-2-1\">\n                        Encuentra tu SUFI\n                    </h2>\n            