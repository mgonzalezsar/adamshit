      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --ink: #0a0a09;\n    --panel: #151513;\n    --panel-soft: #1c1b18;\n    --paper: #f0eee8;\n    --muted: #a7a39a;\n    --yellow: #edb728;\n    --red: #a82e23;\n    --red-bright: #e05a4f;\n    --line: rgba(240,238,232,.16);\n    --line-strong: rgba(240,238,232,.28);\n    --display: 'Barlow Condensed', Impact, sans-serif;\n    --mono: 'IBM Plex Mono', 'Courier New', monospace;\n    --ui: 'Space Grotesk', Arial, sans-serif;\n  }\n  html { scroll-behavior: smooth; background: var(--ink); }\n  body { min-width: 320px; margin: 0; overflow-x: hidden; background: var(--ink); color: var(--paper); font-family: var(--ui); }\n  .sufi-page { overflow: hidden; background: var(--ink); }\n  .sufi-container { width: min(100% - 40px, 1160px); margin: 0 auto; }\n  .display { font-family: var(--display); letter-spacing: -.035em; }\n  .mono { font-family: var(--mono); }\n  .icon { display: inline-flex; width: 20px; height: 20px; align-items: center; justify-content: center; color: currentColor; font-size: 20px; line-height: 1; }\n  .eyebrow { color: var(--yellow); font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: .18em; line-height: 1.4; text-transform: uppercase; }\n  .hairline { height: 1px; background: var(--line); }\n  .poster-rule { position: relative; height: 10px; margin: 0 0 34px; overflow: hidden; }\n  .poster-rule::before { position: absolute; top: 4px; left: 0; width: 100%; height: 2px; background: var(--red); content: ''; }\n  .poster-rule::after { position: absolute; top: 0; left: 38%; width: 76px; height: 10px; background: var(--yellow); content: ''; transform: skewX(-28deg); }\n  .site-header { position: sticky; top: 0; z-index: 20; border-bottom: 1px solid var(--line); background: var(--ink); }\n  .site-header__inner { display: flex; min-height: 76px; align-items: center; justify-content: space-between; gap: 28px; }\n  .wordmark { display: inline-flex; align-items: center; gap: 10px; color: var(--paper); text-decoration: none; }\n  .wordmark__sufi, .wordmark__kebab { font-family: var(--display); font-size: 32px; font-weight: 800; line-height: .76; text-transform: uppercase; }\n  .wordmark__kebab { color: var(--red-bright); }\n  .wordmark__lockup { display: flex; flex-direction: column; gap: 1px; }\n  .wordmark__tag { border-left: 1px solid var(--line-strong); padding-left: 10px; color: var(--muted); font-family: var(--mono); font-size: 8px; letter-spacing: .18em; text-transform: uppercase; }\n  .site-nav { display: flex; align-items: center; gap: 24px; }\n  .site-nav a { min-height: 44px; display: inline-flex; align-items: center; color: var(--muted); font-family: var(--mono); font-size: 10px; font-weight: 600; letter-spacing: .1em; text-decoration: none; text-transform: uppercase; }\n  .site-nav a:hover, .site-nav a:focus-visible { color: var(--yellow); }\n  .header-cta { display: inline-flex; min-height: 44px; align-items: center; gap: 9px; border: 1px solid var(--yellow); background: var(--yellow); color: var(--ink); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .08em; padding: 0 16px; text-decoration: none; text-transform: uppercase; }\n  .header-cta:hover, .header-cta:focus-visible { border-color: var(--red-bright); background: var(--red-bright); color: var(--paper); }\n  .hero { border-bottom: 1px solid var(--line); padding: 72px 0 82px; background: var(--ink); }\n  .hero__intro { display: grid; grid-template-columns: minmax(0, 1fr) 430px; gap: 74px; align-items: end; }\n  .hero h1 { max-width: 690px; margin: 16px 0 20px; color: var(--paper); font-size: clamp(72px, 9.4vw, 138px); font-weight: 800; line-height: .78; text-transform: uppercase; }\n  .hero h1 span { color: var(--red-bright); }\n  .hero__lead { max-width: 520px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.6; }\n  .hero__aside { position: relative; min-height: 170px; border-left: 1px solid var(--red); padding: 24px 0 0 28px; }\n  .hero__aside::before { position: absolute; top: 0; left: -1px; width: 8px; height: 42px; background: var(--yellow); content: ''; }\n  .hero__aside p { margin: 0; color: var(--paper); font-family: var(--display); font-size: 42px; font-weight: 800; line-height: .9; text-transform: uppercase; }\n  .hero__aside small { display: block; max-width: 280px; margin-top: 18px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .1em; line-height: 1.7; text-transform: uppercase; }\n  .venue-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin: 66px 0 18px; }\n  .venue-heading h2, .section-heading h2 { margin: 0; color: var(--paper); font-family: var(--display); font-size: clamp(48px, 5.2vw, 74px); font-weight: 800; line-height: .8; text-transform: uppercase; }\n  .venue-heading__note { max-width: 270px; margin: 0 0 3px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .08em; line-height: 1.6; text-align: right; text-transform: uppercase; }\n  .venue-group { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; margin: 0; padding: 0; border: 0; }\n  .venue-card { position: relative; display: flex; min-height: 258px; flex-direction: column; justify-content: space-between; overflow: hidden; border: 1px solid var(--line-strong); background: var(--panel); color: var(--paper); cursor: pointer; padding: 26px 28px 24px; text-align: left; transition: border-color 160ms ease, background-color 160ms ease; }\n  .venue-card:hover, .venue-card:focus-within { border-color: var(--yellow); background: var(--panel-soft); }\n  .venue-card input { position: absolute; width: 1px; height: 1px; opacity: 0; }\n  .venue-card::before { position: absolute; top: 0; right: 0; width: 72px; height: 8px; background: var(--red); content: ''; transform: skewX(-28deg) translateX(22px); }\n  .venue-card::after { position: absolute; right: -5px; bottom: -38px; color: rgba(168,46,35,.17); content: attr(data-number); font-family: var(--display); font-size: 230px; font-weight: 800; line-height: .7; pointer-events: none; }\n  .venue-card:has(input:checked) { border-color: var(--yellow); background: #201e18; }\n  .venue-card:has(input:checked)::before { background: var(--yellow); }\n  .venue-card__top, .venue-card__bottom { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 16px; }\n  .venue-card__label { color: var(--yellow); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; }\n  .venue-card__status { display: inline-flex; min-height: 32px; align-items: center; gap: 7px; border: 1px solid rgba(240,238,232,.22); color: var(--muted); font-family: var(--mono); font-size: 9px; letter-spacing: .08em; padding: 0 9px; text-transform: uppercase; }\n  .venue-card__status::before { width: 6px; height: 6px; border-radius: 50%; background: var(--red-bright); content: ''; }\n  .venue-card h3 { position: relative; z-index: 1; max-width: 300px; margin: 32px 0 7px; font-family: var(--display); font-size: 66px; font-weight: 800; line-height: .78; text-transform: uppercase; }\n  .venue-card__meta { position: relative; z-index: 1; max-width: 280px; margin: 0; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; line-height: 1.7; text-transform: uppercase; }\n  .venue-card__bottom { justify-content: flex-start; margin-top: 24px; }\n  .venue-card__action { display: inline-flex; min-height: 44px; align-items: center; gap: 8px; color: var(--paper); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }\n  .venue-card:has(input:checked) .venue-card__action { color: var(--yellow); }\n  .venue-card__action i { color: var(--red-bright); }\n  .selection-note { display: flex; min-height: 52px; align-items: center; gap: 10px; margin-top: 12px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .07em; line-height: 1.5; text-transform: uppercase; }\n  .selection-note i { color: var(--yellow); }\n  .services { border-bottom: 1px solid var(--line); background: var(--yellow); color: var(--ink); }\n  .services__inner { display: grid; grid-template-columns: 1fr auto; gap: 28px; align-items: center; padding: 22px 0; }\n  .services__rail { display: flex; flex-wrap: wrap; align-items: center; gap: 0; font-family: var(--display); font-size: 30px; font-weight: 800; line-height: .9; text-transform: uppercase; }\n  .services__rail span { display: inline-flex; align-items: center; gap: 17px; }\n  .services__rail span + span::before { width: 26px; height: 2px; margin: 0 18px; background: var(--red); content: ''; transform: rotate(-8deg); }\n  .services__note { max-width: 240px; margin: 0; font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: .08em; line-height: 1.5; text-align: right; text-transform: uppercase; }\n  .editorial { padding: 96px 0 108px; }\n  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }\n  .section-heading__meta { max-width: 350px; margin: 0 0 2px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .07em; line-height: 1.65; text-align: right; text-transform: uppercase; }\n  .mosaic { display: grid; grid-template-columns: 1.06fr 1.54fr .9fr; grid-template-rows: auto auto; gap: 14px; }\n  .mosaic-block { position: relative; overflow: hidden; border: 1px solid var(--line); background: var(--panel); padding: 24px; }\n  .mosaic-block--menus { grid-row: span 2; min-height: 522px; }\n  .mosaic-block--kebabs { min-height: 248px; }\n  .mosaic-block--grill { min-height: 248px; }\n  .mosaic-block--extras { grid-column: 2 / 4; min-height: 246px; }\n  .mosaic-block__title { display: flex; align-items: baseline; justify-content: space-between; gap: 18px; border-bottom: 1px solid var(--red); padding-bottom: 12px; }\n  .mosaic-block__title h3 { margin: 0; color: var(--paper); font-family: var(--display); font-size: 42px; font-weight: 800; line-height: .8; text-transform: uppercase; }\n  .mosaic-block__title span { color: var(--yellow); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n  .price-list { display: grid; gap: 0; margin: 15px 0 0; padding: 0; list-style: none; }\n  .price-row { display: flex; min-height: 44px; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid rgba(240,238,232,.11); color: var(--paper); font-family: var(--ui); font-size: 13px; line-height: 1.15; }\n  .price-row:last-child { border-bottom: 0; }\n  .price-row small { display: block; margin-top: 3px; color: var(--muted); font-family: var(--mono); font-size: 8px; letter-spacing: .06em; text-transform: uppercase; }\n  .price-row strong { flex-shrink: 0; color: var(--yellow); font-family: var(--mono); font-size: 14px; font-weight: 700; white-space: nowrap; }\n  .mosaic-block__media { position: relative; height: 120px; margin: 16px 0 0; overflow: hidden; border-bottom: 2px solid var(--yellow); background: var(--ink); }\n  .mosaic-block__media img { width: 100%; height: 100%; object-fit: cover; opacity: .86; }\n  .mosaic-block__media::after { position: absolute; inset: 0; background: rgba(10,10,9,.18); content: ''; pointer-events: none; }\n  .mosaic-block--menus .mosaic-block__media { height: 178px; margin: -24px -24px 18px; border-bottom: 2px solid var(--yellow); }\n  .mosaic-block--menus .mosaic-block__title, .mosaic-block--menus .price-list { margin-inline: 0; }\n  .mosaic-block--menus .mosaic-block__title { border-bottom-color: var(--yellow); }\n  .mosaic-block--grill .mosaic-block__media { height: 92px; float: right; width: 45%; margin: -8px -8px 12px 18px; border-bottom: 0; border-left: 2px solid var(--red); }\n  .mosaic-block--grill .price-list { clear: both; }\n  .mosaic-block--extras { display: grid; grid-template-columns: 1fr 1.15fr; gap: 26px; align-items: start; }\n  .mosaic-block--extras .mosaic-block__title { grid-column: 1 / -1; }\n  .mosaic-block--extras .mosaic-block__media { height: 106px; margin: 14px 0 0; }\n  .editorial-note { margin: 18px 0 0; color: var(--muted); font-family: var(--mono); font-size: 9px; letter-spacing: .06em; line-height: 1.65; text-transform: uppercase; }\n  .brand-proof { border-block: 1px solid var(--red); background: #24110f; }\n  .brand-proof__inner { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }\n  .proof { min-height: 250px; display: flex; flex-direction: column; justify-content: center; padding: 38px 48px; }\n  .proof + .proof { border-left: 1px solid rgba(240,238,232,.16); }\n  .proof__label { margin: 0; color: var(--yellow); font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; }\n  .proof h2 { margin: 17px 0 0; color: var(--paper); font-family: var(--display); font-size: clamp(66px, 7vw, 108px); font-weight: 800; line-height: .73; text-transform: uppercase; }\n  .proof p { max-width: 320px; margin: 18px 0 0; color: #d0b9ae; font-family: var(--mono); font-size: 9px; letter-spacing: .05em; line-height: 1.65; text-transform: uppercase; }\n  .contact { padding: 102px 0 112px; }\n  .contact__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }\n  .contact__head h2 { max-width: 520px; margin: 0; color: var(--paper); font-family: var(--display); font-size: clamp(62px, 7.3vw, 106px); font-weight: 800; line-height: .75; text-transform: uppercase; }\n  .contact__head p { max-width: 260px; margin: 0 0 5px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .07em; line-height: 1.65; text-align: right; text-transform: uppercase; }\n  .contact-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 14px; }\n  .contact-panel { border: 1px solid var(--line-strong); background: var(--panel); padding: 27px 28px 24px; }\n  .contact-panel__top { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--red); padding-bottom: 18px; }\n  .contact-panel h3 { margin: 0; color: var(--paper); font-family: var(--display); font-size: 50px; font-weight: 800; line-height: .78; text-transform: uppercase; }\n  .contact-panel__state { color: var(--yellow); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-align: right; text-transform: uppercase; }\n  .contact-actions { display: grid; gap: 0; margin-top: 10px; }\n  .contact-action { display: flex; min-height: 54px; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid rgba(240,238,232,.1); color: var(--paper); font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }\n  .contact-action:last-child { border-bottom: 0; }\n  .contact-action__label { display: inline-flex; align-items: center; gap: 10px; }\n  .contact-action__label i { color: var(--red-bright); }\n  .contact-action__pending { color: var(--muted); font-size: 9px; letter-spacing: .04em; text-align: right; }\n  .contact-action[aria-disabled='true'] { cursor: not-allowed; opacity: .72; }\n  .contact-action[aria-disabled='true'] .contact-action__label i { color: var(--muted); }\n  .contact-summary { display: flex; min-height: 58px; align-items: center; justify-content: space-between; gap: 20px; margin-top: 14px; border: 1px solid var(--line); background: #10100e; padding: 0 16px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }\n  .contact-summary strong { color: var(--yellow); font-weight: 700; }\n  .site-footer { border-top: 1px solid var(--line); background: #070706; padding: 42px 0 28px; }\n  .site-footer__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 32px; }\n  .footer-copy { max-width: 300px; margin: 17px 0 0; color: var(--muted); font-size: 13px; line-height: 1.6; }\n  .footer-links { display: flex; flex-wrap: wrap; gap: 20px; color: var(--muted); font-family: var(--mono); font-size: 10px; letter-spacing: .08em; text-transform: uppercase; }\n  .footer-links a { color: inherit; text-decoration: none; }\n  .footer-links a:hover, .footer-links a:focus-visible { color: var(--yellow); }\n  .footer-meta { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 42px; border-top: 1px solid var(--line); padding-top: 17px; color: #77736c; font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }\n  :focus-visible { outline: 2px solid var(--yellow); outline-offset: 4px; }\n  @media (max-width: 900px) {\n    .site-header__inner { min-height: 68px; }\n    .site-nav { display: none; }\n    .hero__intro { grid-template-columns: 1fr; gap: 44px; }\n    .hero__aside { max-width: 440px; min-height: 120px; }\n    .mosaic { grid-template-columns: 1fr 1fr; }\n    .mosaic-block--menus { grid-row: auto; min-height: 0; }\n    .mosaic-block--kebabs, .mosaic-block--grill { min-height: 0; }\n    .mosaic-block--extras { grid-column: 1 / -1; }\n  }\n  @media (max-width: 620px) {\n    .sufi-container { width: min(100% - 28px, 1160px); }\n    .header-cta { padding-inline: 12px; }\n    .header-cta span { display: none; }\n    .wordmark__sufi, .wordmark__kebab { font-size: 27px; }\n    .hero { padding: 52px 0 62px; }\n    .hero h1 { font-size: clamp(66px, 19vw, 92px); line-height: .78; }\n    .hero__lead { font-size: 15px; }\n    .hero__aside p { font-size: 34px; }\n    .venue-heading { display: block; margin-top: 54px; }\n    .venue-heading__note { margin-top: 15px; text-align: left; }\n    .venue-group { grid-template-columns: 1fr; }\n    .venue-card { min-height: 224px; padding: 22px 22px 20px; }\n    .venue-card h3 { margin-top: 27px; font-size: 60px; }\n    .services__inner { display: block; padding: 19px 0 21px; }\n    .services__rail { gap: 10px 0; font-size: 24px; }\n    .services__rail span { display: flex; width: 100%; min-height: 38px; }\n    .services__rail span + span::before { margin-left: 0; margin-right: 12px; }\n    .services__note { max-width: none; margin-top: 12px; text-align: left; }\n    .editorial { padding: 70px 0 76px; }\n    .section-heading, .contact__head { display: block; }\n    .section-heading__meta, .contact__head p { max-width: 310px; margin-top: 17px; text-align: left; }\n    .mosaic { grid-template-columns: 1fr; gap: 12px; }\n    .mosaic-block--extras { display: block; }\n    .mosaic-block--extras .mosaic-block__title { margin-bottom: 15px; }\n    .mosaic-block--menus .mosaic-block__media { height: 148px; }\n    .mosaic-block--grill .mosaic-block__media { float: none; width: 100%; height: 142px; margin: 16px 0 0; border-left: 0; border-bottom: 2px solid var(--red); }\n    .brand-proof__inner { grid-template-columns: 1fr; }\n    .proof { min-height: 190px; padding: 32px 28px; }\n    .proof + .proof { border-top: 1px solid rgba(240,238,232,.16); border-left: 0; }\n    .proof h2 { font-size: 76px; }\n    .contact { padding: 74px 0 82px; }\n    .contact-grid { grid-template-columns: 1fr; }\n    .contact-panel { padding: 23px 20px 18px; }\n    .contact-panel h3 { font-size: 45px; }\n    .contact-action { min-height: 58px; }\n    .contact-action__pending { max-width: 120px; }\n    .contact-summary { align-items: flex-start; flex-direction: column; justify-content: center; gap: 7px; padding-block: 13px; }\n    .site-footer__top { display: block; }\n    .footer-links { margin-top: 28px; gap: 14px 20px; }\n    .footer-meta { align-items: flex-