</section>\n        <section aria-labelledby=\"quality-title\" class=\"overflow-hidden bg-[var(--red)] text-[var(--ivory)]\" data-kid=\"1-2-5\">\n            <div class=\"mx-auto grid max-w-[1180px] gap-8 px-5 py-16 md:grid-cols-2 md:items-end md:px-8 md:py-20\" data-kid=\"1-2-5-1\">\n                <div data-kid=\"1-2-5-1-1\">\n                    <p class=\"m-0 text-[10px] uppercase tracking-[.24em] text-[rgba(240,238,232,.72)] su-mono\" data-kid=\"1-2-5-1-1-1\">\n                        Lo que enciende la marca\n                    </p>\n                    <h2 class=\"su-display mt-5 text-[68px] font-extrabold uppercase leading-[.76] md:text-[100px]\" data-kid=\"1-2-5-1-1-2\" id=\"quality-title\">\n                        Halal\n                        <br data-kid=\"1-2-5-1-1-2-1\"/>\n                        <span class=\"text-[var(--yellow)]\" data-kid=\"1-2-5-1-1-2-2\">\n                            100%.\n                        </span>\n                    </h2>\n                </div>\n                <div class=\"md:border-l md:border-[rgba(240,238,232,.35)] md:pl-10\" data-kid=\"1-2-5-1-2\">\n                    <p class=\"su-display m-0 text-[58px] font-extrabold uppercase leading-[.78] md:text-[78px]\" data-kid=\"1-2-5-1-2-1\">\n                        Carne\n                        <br data-kid=\"1-2-5-1-2-1-1\"/>\n                        <span class=\"text-[var(--yellow)]\" data-kid=\"1-2-5-1-2-1-2\">\n                            de calidad.\n                        </span>\n                    </p>\n                    <p class=\"mt-8 max-w-[420px] text-[12px] leading-5 text-[rgba(240,238,232,.78)] su-mono\" data-kid=\"1-2-5-1-2-2\">\n                        Mensajes presentes en la identidad facilitada. La validación documental y el alcance por local quedan pendientes de confirmación.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"contact-title\" class=\"mx-auto max-w-[1180px] px-5 py-20 md:px-8 md:py-28\" data-kid=\"1-2-6\">\n            <div class=\"grid gap-12 md:grid-cols-[.9fr_1.1fr] md:gap-20\" data-kid=\"1-2-6-1\">\n                <div data-kid=\"1-2-6-1-1\">\n                    <p class=\"m-0 text-[10px] font-semibold uppercase tracking-[.24em] text-[var(--red-light)] su-mono\" data-kid=\"1-2-6-1-1-1\">\n                        Contacto operativo\n                    </p>\n                    <h2 class=\"su-display mt-4 text-[70px] font-extrabold uppercase leading-[.76] md:text-[96px]\" data-kid=\"1-2-6-1-1-2\" id=\"contact-title\">\n                        Elige\n                        <br data-kid=\"1-2-6-1-1-2-1\"/>\n                        <span class=\"text-[var(--red-light)]\" data-kid=\"1-2-6-1-1-2-2\">\n                            tu SUFI.\n                        </span>\n                    </h2>\n                    <p class=\"mt-7 max-w-[370px] text-[15px] leading-6 text-[var(--muted)]\" data-kid=\"1-2-6-1-1-3\">\n                        Selecciona una sede para activar sus formas de contacto. Hasta confirmar los datos, ninguna acción te llevará a un destino incorrecto.\n                    </p>\n                </div>\n                <div class=\"border-t border-[var(--red)] pt-5\" data-kid=\"1-2-6-1-2\">\n                    <div class=\"flex items-center justify-between gap-4 border-b border-[var(--line)] pb-5\" data-kid=\"1-2-6-1-2-1\">\n                        <div data-kid=\"1-2-6-1-2-1-1\">\n                            <p class=\"m-0 text-[10px] uppercase tracking-[.18em] text-[var(--red-light)] su-mono\" data-kid=\"1-2-6-1-2-1-1-1\">\n                                Local seleccionado\n                            </p>\n                            <p class=\"su-display mt-2 text-[48px] font-extrabold uppercase leading-[.8]\" data-dynamic=\"true\" data-kid=\"1-2-6-1-2-1-1-2\" data-location-name=\"\" data-name=\"selected local name display\" data-reason=\"text replaced on radio selection by script\">\n                                Local 01\n                            </p>\n                        </div>\n                        <span class=\"border border-[var(--yellow)] px-3 py-2 text-[10px] uppercase tracking-[.14em] text-[var(--yellow)] su-mono\" data-kid=\"1-2-6-1-2-1-2\">\n                            Pendiente\n                        </span>\n                    </div>\n                    <p class=\"mt-5 text-[12px] leading-5 text-[var(--muted)] su-mono\" data-contact-note=\"\" data-dynamic=\"true\" data-kid=\"1-2-6-1-2-2\" data-name=\"selected local contact note\" data-reason=\"text replaced on radio selection by script\">\n                        Dirección, teléfono, WhatsApp y Maps se habilitarán cuando se confirme la ficha de este local.\n                    </p>\n                    <div class=\"mt-7 grid gap-3 sm:grid-cols-3\" data-kid=\"1-2-6-1-2-3\">\n                        <button aria-disabled=\"true\" class=\"flex min-h-[58px] cursor-not-allowed items-center gap-3 border border-[var(--line)] px-4 text-left text-[10px] font-semibold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-1\" disabled=\"\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-phone shrink-0\" data-kid=\"1-2-6-1-2-3-1-1\" style=\"font-size:20px;width:20px;height:20px;line-height:20px;color:var(--red-light)\">\n                            </i>\n                            <span data-kid=\"1-2-6-1-2-3-1-2\">\n                                Llamar\n                                <br data-kid=\"1-2-6-1-2-3-1-2-1\"/>\n                                <small class=\"font-normal normal-case tracking-normal text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-1-2-2\">\n                                    En preparación\n                                </small>\n                            </span>\n                        </button>\n                        <button aria-disabled=\"true\" class=\"flex min-h-[58px] cursor-not-allowed items-center gap-3 border border-[var(--line)] px-4 text-left text-[10px] font-semibold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-2\" disabled=\"\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brand-whatsapp shrink-0\" data-kid=\"1-2-6-1-2-3-2-1\" style=\"font-size:20px;width:20px;height:20px;line-height:20px;color:var(--red-light)\">\n                            </i>\n                            <span data-kid=\"1-2-6-1-2-3-2-2\">\n                                WhatsApp\n                                <br data-kid=\"1-2-6-1-2-3-2-2-1\"/>\n                                <small class=\"font-normal normal-case tracking-normal text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-2-2-2\">\n                                    En preparación\n                                </small>\n                            </span>\n                        </button>\n                        <button aria-disabled=\"true\" class=\"flex min-h-[58px] cursor-not-allowed items-center gap-3 border border-[var(--line)] px-4 text-left text-[10px] font-semibold uppercase tracking-[.08em] text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-3\" disabled=\"\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin shrink-0\" data-kid=\"1-2-6-1-2-3-3-1\" style=\"font-size:20px;width:20px;height:20px;line-height:20px;color:var(--red-light)\">\n                            </i>\n                            <span data-kid=\"1-2-6-1-2-3-3-2\">\n                                Maps\n                                <br data-kid=\"1-2-6-1-2-3-3-2-1\"/>\n                                <small class=\"font-normal normal-case tracking-normal text-[var(--muted)]\" data-kid=\"1-2-6-1-2-3-3-2-2\">\n                                    En preparación\n                                </small>\n                            </span>\n                        </button>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"border-t border-[var(--line-soft)] bg-[var(--panel)]\" data-kid=\"1-3\">\n        <div class=\"mx-auto grid max-w-[1180px] gap-10 px-5 py-12 md:grid-cols-[1fr_auto] md:items-end md:px-8\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"su-display m-0 text-[54px] font-extrabold uppercase leading-[.72]\" data-kid=\"1-3-1-1-1\">\n                    SUFI\n                    <br data-kid=\"1-3-1-1-1-1\"/>\n                    <span class=\"text-[var(--red-light)]\" data-kid=\"1-3-1-1-1-2\">\n                        KEBAB\n                    </span>\n                </p>\n                <p class=\"mt-5 max-w-[360px] text-[12px] leading-5 text-[var(--muted)]\" data-kid=\"1-3-1-1-2\">\n                    Dos locales. Un solo fuego. Carta digital y datos de sede en preparación.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-x-7 gap-y-3 text-[10px] uppercase tracking-[.14em] text-[var(--muted)] su-mono\" data-kid=\"1-3-1-2\">\n                <a class=\"min-h-[44px] py-3 hover:text-[var(--yellow)]\" data-kid=\"1-3-1-2-1\" href=\"#locales\">\n                    Elegir local\n                </a>\n                <a class=\"min-h-[44px] py-3 hover:text-[var(--yellow)]\" data-kid=\"1-3-1-2-2\" href=\"#destacados\">\n                    Destacados\n                </a>\n                <a class=\"min-h-[44px] py-3 hover:text-[var(--yellow)]\" data-kid=\"1-3-1-2-3\" href=\"#servicios\">\n                    Servicios\n                </a>\n            </div>\n        </div>\n        <div class=\"mx-auto flex max-w-[1180px] flex-col gap-2 border-t border-[var(--line-soft)] px-5 py-5 text-[10px] uppercase tracking-[.12em] text-[var(--muted)] su-mono md:flex-row md:items-center md:justify-between md:px-8\" data-kid=\"1-3-2\">\n            <span data-kid=\"1-3-2-1\">\n                Precios de trabajo · confirmar por local\n            </span>\n            <span data-kid=\"1-3-2-2\">\n                SUFI KEBAB · 2026\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    const locationStatus = document.querySelector('#location-status span');\n  const selectedName = document.querySelector('[data-location-name]');\n  const contactNote = document.querySelector('[data-contact-note]');\n  document.querySelectorAll('input[name=\"location\"]').forEach((radio) => {\n    radio.addEventListener('change', () => {\n      const name = radio.value;\n      if (locationStatus) locationStatus.textContent = `${name} seleccionado. Estamos confirmando dirección, horario y contacto.`;\n      if (selectedName) selectedName.textContent = name;\n      if (contactNote) contactNote.textContent = `Dirección, teléfono, WhatsApp y Maps se habilitarán cuando se confirme la ficha de este local.`;\n    });\n  });\n</script>\n",
