      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n  :root {\n    --night: #10263a;\n    --ink: #0b1826;\n    --limestone: #e9ede8;\n    --orange: #e65d2c;\n    --mustard: #d4a72b;\n    --paper: #f6f7f3;\n    --muted: #5d686d;\n    --line: rgba(16, 38, 58, .22);\n    --display: 'Barlow Condensed', Impact, sans-serif;\n    --body: 'IBM Plex Sans', Arial, sans-serif;\n  }\n\n  html { scroll-behavior: smooth; }\n  body { margin: 0; background: var(--limestone); color: var(--ink); font-family: var(--body); }\n  @layer base { *, *::before, *::after { box-sizing: border-box; } }\n  button, a { font: inherit; }\n  a { color: inherit; text-decoration: none; }\n  button:focus-visible, a:focus-visible { outline: 2px solid var(--mustard); outline-offset: 4px; }\n\n  .kebab-page { min-height: 100vh; background: var(--limestone); overflow: hidden; }\n  .topbar { height: 72px; padding: 0 72px; display: flex; align-items: center; justify-content: space-between; background: var(--ink); color: var(--limestone); position: sticky; top: 0; z-index: 20; border-bottom: 1px solid rgba(233,237,232,.16); }\n  .wordmark { display: inline-flex; align-items: center; gap: 11px; letter-spacing: .06em; font-family: var(--display); font-size: 26px; line-height: 1; font-weight: 800; }\n  .wordmark-mark { width: 22px; height: 22px; border: 2px solid var(--orange); display: inline-flex; align-items: center; justify-content: center; font-family: var(--body); font-size: 11px; font-weight: 700; color: var(--orange); }\n  .topnav { display: flex; align-items: center; gap: 28px; font-size: 13px; font-weight: 600; letter-spacing: .02em; }\n  .topnav a { opacity: .82; transition: opacity .2s ease, color .2s ease; }\n  .topnav a:hover { opacity: 1; color: var(--orange); }\n  .phone-link { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 17px; background: var(--orange); color: var(--ink); border: 1px solid var(--orange); font-weight: 700; transition: background .2s ease, color .2s ease; }\n  .phone-link:hover { background: transparent; color: var(--limestone); }\n  .phone-link i { font-size: 16px; }\n\n  .hero { height: 500px; position: relative; display: grid; place-items: center; overflow: hidden; background: var(--night); isolation: isolate; }\n  .hero-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 56%; z-index: -3; filter: saturate(.9) contrast(1.04); }\n  .hero::before { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,24,38,.87), rgba(16,38,58,.56) 48%, rgba(11,24,38,.88)); z-index: -2; }\n  .hero::after { content: ''; position: absolute; inset: 0; background: repeating-linear-gradient(90deg, rgba(233,237,232,.04) 0, rgba(233,237,232,.04) 1px, transparent 1px, transparent 72px); mix-blend-mode: screen; opacity: .55; z-index: -1; pointer-events: none; }\n  .hero-plate { width: 446px; min-height: 390px; margin-top: 1px; padding: 29px 38px 62px; position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; background: var(--limestone); border: 2px solid var(--ink); box-shadow: 12px 12px 0 rgba(11,24,38,.3); }\n  .hero-kicker { margin: 0 0 2px; color: var(--night); font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; }\n  .hero-title { margin: 0; color: var(--night); font-family: var(--display); font-size: 66px; line-height: .84; letter-spacing: .018em; font-weight: 800; }\n  .hero-city { margin: 6px 0 13px; color: var(--orange); font-family: var(--display); font-size: 82px; line-height: .78; letter-spacing: .01em; font-weight: 800; }\n  .plate-rule { width: 54px; height: 4px; margin: 1px auto 15px; background: var(--orange); }\n  .hero-hours-label { margin: 0 0 5px; font-family: var(--display); color: var(--night); font-size: 20px; line-height: 1; text-transform: uppercase; letter-spacing: .08em; }\n  .hero-hours { margin: 0; color: var(--ink); font-size: 15px; line-height: 1.35; font-weight: 600; letter-spacing: .015em; }\n  .hero-rating { margin: 12px 0 0; color: var(--muted); font-size: 13px; font-weight: 600; }\n  .hero-rating strong { color: var(--mustard); font-size: 18px; letter-spacing: .03em; }\n  .hero-actions { position: absolute; left: 22px; right: 22px; bottom: -24px; display: grid; grid-template-columns: 1.2fr .85fr 1fr; gap: 8px; z-index: 2; }\n  .hero-action { min-height: 48px; padding: 0 11px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid var(--ink); font-size: 12px; font-weight: 700; white-space: nowrap; transition: background .2s ease, color .2s ease, transform .2s ease; }\n  .hero-action:hover { transform: translateY(-2px); }\n  .hero-action i { font-size: 15px; }\n  .hero-action.primary { background: var(--orange); color: var(--ink); border-color: var(--orange); }\n  .hero-action.primary:hover { background: var(--ink); color: var(--limestone); }\n  .hero-action.secondary { background: var(--limestone); color: var(--ink); }\n  .hero-action.secondary:hover { background: var(--mustard); }\n  .hero-action.quiet { background: var(--ink); color: var(--limestone); border-color: var(--ink); }\n  .hero-action.quiet:hover { color: var(--orange); }\n\n  .selection { background: var(--orange); color: var(--ink); border-bottom: 1px solid rgba(11,24,38,.35); }\n  .selection-bar { min-height: 78px; padding: 0 72px; display: flex; align-items: center; justify-content: space-between; gap: 32px; }\n  .selection-list { margin: 0; font-family: var(--display); font-size: 27px; line-height: 1; font-weight: 700; letter-spacing: .035em; word-spacing: .12em; }\n  .selection-toggle { min-width: 166px; min-height: 40px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; background: transparent; color: var(--ink); border: 1px solid var(--ink); cursor: pointer; font-size: 12px; font-weight: 700; transition: background .2s ease, color .2s ease; }\n  .selection-toggle:hover, .selection-toggle[aria-expanded=\"true\"] { background: var(--ink); color: var(--limestone); }\n  .selection-toggle i { font-size: 16px; }\n  .specialty-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .3s ease; background: var(--limestone); color: var(--ink); }\n  .specialty-panel.is-open { grid-template-rows: 1fr; }\n  .specialty-panel-inner { min-height: 0; overflow: hidden; }\n  .specialty-copy { max-width: 860px; padding: 20px 72px 22px; font-size: 15px; line-height: 1.5; }\n  .specialty-copy strong { font-weight: 700; }\n\n  .info-section { padding: 104px 8vw 116px; display: grid; grid-template-columns: 56% 44%; background: var(--limestone); }\n  .info-column { min-height: 452px; position: relative; }\n  .info-column:first-child { padding-right: 94px; }\n  .info-column:last-child { padding-left: 94px; border-left: 2px solid var(--orange); }\n  .ghost-number { position: absolute; top: -36px; left: -20px; color: rgba(16,38,58,.075); font-family: var(--display); font-size: 210px; line-height: .7; font-weight: 800; pointer-events: none; }\n  .section-eyebrow { margin: 0 0 13px; color: var(--orange); font-size: 12px; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; position: relative; }\n  .section-heading { margin: 0; max-width: 430px; color: var(--night); font-family: var(--display); font-size: 62px; line-height: .86; letter-spacing: .015em; text-transform: uppercase; position: relative; }\n  .section-lede { margin: 18px 0 36px; max-width: 410px; color: var(--muted); font-size: 16px; line-height: 1.5; position: relative; }\n  .time-grid { max-width: 490px; display: grid; gap: 15px; position: relative; }\n  .time-row { display: grid; grid-template-columns: 148px 1fr; align-items: center; border-top: 1px solid var(--line); padding-top: 14px; }\n  .time-label { color: var(--night); font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }\n  .time-value { color: var(--ink); font-family: var(--body); font-size: 24px; font-weight: 700; letter-spacing: .015em; }\n  .status-line { margin: 25px 0 0; padding-top: 15px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; font-weight: 600; position: relative; }\n  .status-line span { color: var(--orange); }\n  .address { margin: 20px 0 0; display: flex; gap: 12px; align-items: flex-start; color: var(--ink); font-size: 23px; line-height: 1.25; font-weight: 600; position: relative; }\n  .address i { margin-top: 3px; color: var(--orange); font-size: 23px; }\n  .route-button { margin-top: 25px; min-height: 48px; padding: 0 18px; display: inline-flex; align-items: center; gap: 8px; background: var(--orange); color: var(--ink); border: 1px solid var(--orange); font-size: 13px; font-weight: 700; transition: background .2s ease, color .2s ease; position: relative; }\n  .route-button:hover { background: var(--ink); color: var(--limestone); }\n  .route-button i { font-size: 17px; }\n  .service-rule { margin: 42px 0 18px; border: 0; border-top: 1px solid var(--line); }\n  .service-title { margin: 0 0 17px; color: var(--night); font-family: var(--display); font-size: 24px; line-height: 1; text-transform: uppercase; letter-spacing: .06em; }\n  .service-list { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; row-gap: 12px; margin: 0; padding: 0; list-style: none; position: relative; }\n  .service-list li { display: flex; align-items: center; gap: 9px; color: var(--muted); font-size: 14px; }\n  .service-list li::before { content: ''; width: 7px; height: 7px; flex: 0 0 7px; background: var(--orange); }\n  .service-list li:last-child::after { content: '♿'; color: var(--orange); font-size: 14px; margin-left: 1px; }\n  .terrace-note { margin: 22px 0 0; color: var(--muted); font-size: 14px; position: relative; }\n  .terrace-note strong { color: var(--ink); }\n\n  .footer { min-height: 390px; padding: 72px 8vw 23px; position: relative; background: var(--ink); color: var(--limestone); overflow: hidden; }\n  .footer::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 14%; background: rgba(233,237,232,.08); pointer-events: none; }\n  .footer-grid { display: grid; grid-template-columns: 1.05fr .85fr 1.15fr; gap: 76px; position: relative; z-index: 1; }\n  .footer-label { margin: 0 0 13px; color: var(--orange); font-size: 11px; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }\n  .footer-brand { margin: 0; color: var(--limestone); font-family: var(--display); font-size: 43px; line-height: .9; text-transform: uppercase; letter-spacing: .01em; }\n  .footer-copy { max-width: 260px; margin: 20px 0 25px; color: rgba(233,237,232,.7); font-size: 14px; line-height: 1.5; }\n  .footer-phone { display: inline-flex; align-items: center; gap: 8px; color: var(--limestone); font-size: 14px; font-weight: 700; }\n  .footer-phone i { color: var(--orange); font-size: 17px; }\n  .footer-title { margin: 0 0 18px; color: var(--limestone); font-family: var(--display); font-size: 28px; line-height: 1; text-transform: uppercase; letter-spacing: .05em; }\n  .footer-links { display: grid; gap: 12px; margin: 0; padding: 0; list-style: none; color: rgba(233,237,232,.72); font-size: 14px; }\n  .footer-links a { transition: color .2s ease; }\n  .footer-links a:hover { color: var(--orange); }\n  .footer-cta { max-width: 380px; margin-left: auto; }\n  .footer-cta h2 { margin: 0; color: var(--limestone); font-family: var(--display); font-size: 58px; line-height: .86; text-transform: uppercase; letter-spacing: .012em; }\n  .footer-address { margin: 21px 0 24px; color: rgba(233,237,232,.7); font-size: 14px; line-height: 1.45; }\n  .footer-route { min-height: 48px; padding: 0 18px; display: inline-flex; align-items: center; gap: 9px; background: var(--orange); color: var(--ink); border: 1px solid var(--orange); font-size: 13px; font-weight: 700; transition: background .2s ease, color .2s ease; }\n  .footer-route:hover { background: transparent; color: var(--limestone); }\n  .footer-route i { font-size: 17px; }\n  .footer-bottom { margin-top: 66px; padding-top: 16px; display: flex; justify-content: space-between; border-top: 1px solid rgba(233,237,232,.18); color: rgba(233,237,232,.46); font-size: 11px; position: relative; z-index: 1; }\n\n  @media (max-width: 900px) {\n    .topbar { padding: 0 28px; }\n    .topnav { gap: 15px; }\n    .topnav a:not(.phone-link) { display: none; }\n    .selection-bar { padding: 0 28px; }\n    .selection-list { font-size: 23px; }\n    .specialty-copy { padding-left: 28px; padding-right: 28px; }\n    .info-section { padding-left: 6vw; padding-right: 6vw; }\n    .info-column:first-child { padding-right: 48px; }\n    .info-column:last-child { padding-left: 48px; }\n    .footer { padding-left: 6vw; padding-right: 6vw; }\n    .footer-grid { gap: 34px; }\n  }\n  @media (max-width: 700px) {\n    .topbar { height: 64px; padding: 0 18px; }\n    .wordmark { font-size: 23px; }\n    .phone-link { padding: 0 11px; font-size: 0; }\n    .phone-link i { font-size: 17px; }\n    .hero { height: 570px; }\n    .hero-plate { width: calc(100% - 34px); min-height: 405px; padding: 28px 22px 74px; }\n    .hero-title { font-size: 51px; }\n    .hero-city { font-size: 66px; }\n    .hero-actions { left: 14px; right: 14px; grid-template-columns: 1fr; gap: 6px; bottom: -77px; }\n    .hero-action { min-height: 43px; }\n    .selection-bar { min-height: 92px; padding: 17px 18px; align-items: flex-start; flex-direction: column; gap: 12px; }\n    .selection-list { font-size: 21px; line-height: 1.15; }\n    .selection-toggle { min-height: 37px; }\n    .specialty-copy { padding: 17px 18px 20px; }\n    .info-section { padding: 76px 26px 84px; display: block; }\n    .info-column { min-height: 0; }\n    .info-column:first-child { padding: 0 0 72px; }\n    .info-column:last-child { padding: 72px 0 0; border-top: 2px solid var(--orange); border-left: 0; }\n    .section-heading { font-size: 53px; }\n    .time-row { grid-template-columns: 126px 1fr; }\n    .time-value { font-size: 20px; }\n    .address { font-size: 20px; }\n    .service-list { grid-template-columns: 1fr; }\n    .footer { min-height: 0; padding: 62px 26px 22px; }\n    .footer::after { width: 22%; }\n    .footer-grid { grid-template-columns: 1fr; gap: 52px; }\n    .footer-cta { margin-left: 0; }\n    .footer-cta h2 { font-size: 50px; }\n    .footer-bottom { margin-top: 52px; gap: 14px; flex-direction: column; }\n  }\n</style>\n<div class=\"kebab-page\" data-kid=\"1\">\n    <header class=\"topbar\" data-kid=\"1-1\">\n        <a aria-label=\"Kebab Sufi Orihuela\" class=\"wordmark\" data-kid=\"1-1-1\" href=\"#inicio\">\n            <span class=\"wordmark-mark\" data-kid=\"1-1-1-1\">\n                S\n            </span>\n            <span data-kid=\"1-1-1-2\">\n                KEBAB SUFI\n            </span>\n        </a>\n        <nav aria-label=\"Navegación principal\" class=\"topnav\" data-kid=\"1-1-2\">\n            <a data-kid=\"1-1-2-1\" href=\"#especialidades\">\n                Qué comer\n            </a>\n            <a data-kid=\"1-1-2-2\" href=\"#horario\">\n                Horario\n            </a>\n            <a data-kid=\"1-1-2-3\" href=\"#ubicacion\">\n                Cómo llegar\n            </a>\n            <a class=\"phone-link\" data-kid=\"1-1-2-4\" href=\"tel:+34966344188\">\n                <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-1-2-4-1\">\n                </i>\n                <span data-kid=\"1-1-2-4-2\">\n                    Llamar\n                </span>\n            </a>\n        </nav>\n    </header>\n    <main data-kid=\"1-2\">\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"1-2-1\" id=\"inicio\">\n            <img alt=\"Comida crujiente servida con patatas y salsa en Kebab Sufi Orihuela\" class=\"hero-media\" data-kid=\"1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.toppingsandsalads.es/images/a59e150a0c800dce69c28a5a65dc06d0.jpg\"/>\n            <div class=\"hero-plate\" data-kid=\"1-2-1-2\">\n                <p class=\"hero-kicker\" data-kid=\"1-2-1-2-1\">\n                    Comida turca · Vega Baja\n                </p>\n                <h1 class=\"hero-title\" data-kid=\"1-2-1-2-2\" id=\"hero-title\">\n                    KEBAB SUFI\n                </h1>\n                <p class=\"hero-city\" data-kid=\"1-2-1-2-3\">\n                    ORIHUELA\n                </p>\n                <div class=\"plate-rule\" data-kid=\"1-2-1-2-4\">\n                </div>\n                <p class=\"hero-hours-label\" data-kid=\"1-2-1-2-5\">\n                    Hoy · horario diario\n                </p>\n                <p class=\"hero-hours\" data-kid=\"1-2-1-2-6\">\n                    12:00–16:00   /   18:00–00:30\n                </p>\n                <p class=\"hero-rating\" data-kid=\"1-2-1-2-7\">\n                    <strong data-kid=\"1-2-1-2-7-1\">\n                        ★ 8,4\n                    </strong>\n                    en 762 reseñas\n                </p>\n                <div class=\"hero-actions\" data-kid=\"1-2-1-2-8\">\n                    <a class=\"hero-action primary\" data-kid=\"1-2-1-2-8-1\" href=\"#especialidades\">\n                        <i aria-hidden=\"true\" class=\"ti ti-tools-kitchen-2\" data-kid=\"1-2-1-2-8-1-1\">\n                        </i>\n                        Ver qué preparamos\n                    </a>\n                    <a class=\"hero-action secondary\" data-kid=\"1-2-1-2-8-2\" href=\"tel:+34966344188\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-2-1-2-8-2-1\">\n                        </i>\n                        Llamar\n                    </a>\n                    <a class=\"hero-action quiet\" data-kid=\"1-2-1-2-8-3\" href=\"#ubicacion\">\n                        <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-2-1-2-8-3-1\">\n                        </i>\n                        Cómo llegar\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Selección gastronómica\" class=\"selection\" data-kid=\"1-2-2\" id=\"especialidades\">\n            <div class=\"selection-bar\" data-kid=\"1-2-2-1\">\n                <p class=\"selection-list\" data-kid=\"1-2-2-1-1\">\n                    KEBAB · DÜRÜM · HAMBURGUESAS · ALITAS · PATATAS\n                </p>\n                <button aria-controls=\"specialty-panel\" aria-expanded=\"false\" class=\"selection-toggle\" data-kid=\"1-2-2-1-2\" id=\"specialty-toggle\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-plus\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2-1\" data-name=\"selection toggle icon\" data-reason=\"icon class replaced by script on click\">\n                    </i>\n                    <span data-dynamic=\"true\" data-kid=\"1-2-2-1-2-2\" data-name=\"selection toggle button label text\" data-reason=\"text replaced by script on click\">\n                        Ver qué preparamos\n                    </span>\n                </button>\n            </div>\n            <div class=\"specialty-panel\" data-kid=\"1-2-2-2\" id=\"specialty-panel\">\n                <div class=\"specialty-panel-inner\" data-kid=\"1-2-2-2-1\">\n                    <p class=\"specialty-copy\" data-kid=\"1-2-2-2-1-1\">\n                        <strong data-kid=\"1-2-2-2-1-1-1\">\n                            Carne fresca, salsa blanca y raciones generosas.\n                        </strong>\n                        Elige entre kebab, dürüm, hamburguesas, alitas y patatas. Para comer aquí, recoger o pedir a domicilio.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"info-section\" data-kid=\"1-2-3\" id=\"horario\">\n            <div class=\"info-column\" data-kid=\"1-2-3-1\">\n                <span aria-hidden=\"true\" class=\"ghost-number\" data-kid=\"1-2-3-1-1\">\n                    12\n                </span>\n                <p class=\"section-eyebrow\" data-kid=\"1-2-3-1-2\">\n                    Todos los días\n                </p>\n                <h2 class=\"section-heading\" data-kid=\"1-2-3-1-3\">\n                    Cuándo pasar\n                </h2>\n                <p class=\"section-lede\" data-kid=\"1-2-3-1-4\">\n                    Abrimos a mediodía y volvemos por la tarde para que la cena no tenga hora de cierre.\n                </p>\n                <div class=\"time-grid\" data-kid=\"1-2-3-1-5\">\n                    <div class=\"time-row\" data-kid=\"1-2-3-1-5-1\">\n                        <span class=\"time-label\" data-kid=\"1-2-3-1-5-1-1\">\n                            Mediodía\n                        </span>\n                        <span class=\"time-value\" data-kid=\"1-2-3-1-5-1-2\">\n                            12:00 — 16:00\n                        </span>\n                    </div>\n                    <div class=\"time-row\" data-kid=\"1-2-3-1-5-2\">\n                        <span class=\"time-label\" data-kid=\"1-2-3-1-5-2-1\">\n                            Noche\n                        </span>\n                        <span class=\"time-value\" data-kid=\"1-2-3-1-5-2-2\">\n                            18:00 — 00:30\n                        </span>\n                    </div>\n                </div>\n                <p class=\"status-line\" data-kid=\"1-2-3-1-6\">\n                    <span data-kid=\"1-2-3-1-6-1\">\n                        ●\n                    </span>\n                    Horario habitual de lunes a domingo.\n                </p>\n            </div>\n            <div class=\"info-column\" data-kid=\"1-2-3-2\" id=\"ubicacion\">\n                <span aria-hidden=\"true\" class=\"ghost-number\" data-kid=\"1-2-3-2-1\">\n                    20\n                </span>\n                <p class=\"section-eyebrow\" data-kid=\"1-2-3-2-2\">\n                    Estamos en Orihuela\n                </p>\n                <h2 class=\"section-heading\" data-kid=\"1-2-3-2-3\">\n                    Dónde estamos\n                </h2>\n                <p class=\"address\" data-kid=\"1-2-3-2-4\">\n                    <i aria-hidden=\"true\" class=\"ti ti-map-pin\" data-kid=\"1-2-3-2-4-1\">\n                    </i>\n                    <span data-kid=\"1-2-3-2-4-2\">\n                        C. Duque de Tamames, 20\n                        <br data-kid=\"1-2-3-2-4-2-1\"/>\n                        03300 Orihuela, Alicante\n                    </span>\n                </p>\n                <a class=\"route-button\" data-kid=\"1-2-3-2-5\" href=\"https://www.google.com/maps/search/?api=1&query=C.%20Duque%20de%20Tamames%2C%2020%2C%2003300%20Orihuela%2C%20Alicante\" rel=\"noreferrer\" target=\"_blank\">\n                    <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"1-2-3-2-5-1\">\n                    </i>\n                    Ir a Duque de Tamames\n                </a>\n                <hr class=\"service-rule\" data-kid=\"1-2-3-2-6\"/>\n                <h3 class=\"service-title\" data-kid=\"1-2-3-2-7\">\n                    Al llegar\n                </h3>\n                <ul class=\"service-list\" data-kid=\"1-2-3-2-8\">\n                    <li data-kid=\"1-2-3-2-8-1\">\n                        Comer en el local\n                    </li>\n                    <li data-kid=\"1-2-3-2-8-2\">\n                        Para llevar\n                    </li>\n                    <li data-kid=\"1-2-3-2-8-3\">\n                        Entrega a domicilio\n                    </li>\n                    <li data-kid=\"1-2-3-2-8-4\">\n                        Terraza\n                    </li>\n                    <li data-kid=\"1-2-3-2-8-5\">\n                        Entrada accesible\n                    </li>\n                </ul>\n                <p class=\"terrace-note\" data-kid=\"1-2-3-2-9\">\n                    Un local cercano,\n                    <strong data-kid=\"1-2-3-2-9-1\">\n                        trato amable\n                    </strong>\n                    y sitio para sentarse.\n                </p>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"1-3\">\n        <div class=\"footer-grid\" data-kid=\"1-3-1\">\n            <div data-kid=\"1-3-1-1\">\n                <p class=\"footer-label\" data-kid=\"1-3-1-1-1\">\n                    Kebab Sufi\n                </p>\n                <h2 class=\"footer-brand\" data-kid=\"1-3-1-1-2\">\n                    Orihuela\n                </h2>\n                <p class=\"footer-copy\" data-kid=\"1-3-1-1-3\">\n                    Comer aquí, para llevar o a domicilio. Kebab, dürüm y más hasta las 00:30.\n                </p>\n                <a class=\"footer-phone\" data-kid=\"1-3-1-1-4\" href=\"tel:+34966344188\">\n                    <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"1-3-1-1-4-1\">\n                    </i>\n                    +34 966 34 41 88\n                </a>\n            </div>\n            <div data-kid=\"1-3-1-2\">\n                <h3 class=\"footer-title\" data-kid=\"1-3-1-2-1\">\n                    Antes de venir\n                </h3>\n                <ul class=\"footer-links\" data-kid=\"1-3-1-2-2\">\n                    <li data-kid=\"1-3-1-2-2-1\">\n                        <a data-kid=\"1-3-1-2-2-1-1\" href=\"#especialidades\">\n                            Qué preparamos\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-2\">\n                        <a data-kid=\"1-3-1-2-2-2-1\" href=\"#horario\">\n                            Horario diario\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-3\">\n                        <a data-kid=\"1-3-1-2-2-3-1\" href=\"#ubicacion\">\n                            Ubicación\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-4\">\n                        <a data-kid=\"1-3-1-2-2-4-1\" href=\"#ubicacion\">\n                            Entrada accesible\n                        </a>\n                    </li>\n                    <li data-kid=\"1-3-1-2-2-5\">\n                        <a data-kid=\"1-3-1-2-2-5-1\" href=\"https://www.instagram.com/pak_orihuela_kebab/\" rel=\"noreferrer\" target=\"_blank\">\n                            Instagram\n                        </a>\n                    </li>\n                </ul>\n            </div>\n            <div class=\"footer-cta\" data-kid=\"1-3-1-3\">\n                <p class=\"footer-label\" data-kid=\"1-3-1-3-1\">\n                    La puerta está aquí\n                </p>\n                <h2 data-kid=\"1-3-1-3-2\">\n                    Duque de Tamames, 20.\n                </h2>\n                <p class=\"footer-address\" data-kid=\"1-3-1-3-3\">\n                    03300 Orihuela · Alicante\n                </p>\n                <a class=\"footer-route\" data-kid=\"1-3-1-3-4\" href=\"https://www.google.com/maps/search/?api=1&query=C.%20Duque%20de%20Tamames%2C%2020%2C%2003300%20Orihuela%2C%20Alicante\" rel=\"noreferrer\" target=\"_blank\">\n                    <i aria-hidden=\"true\" class=\"ti ti-navigation\" data-kid=\"1-3-1-3-4-1\">\n                    </i>\n                    Abrir indicaciones\n                </a>\n            </div>\n        </div>\n        <div class=\"footer-bottom\" data-kid=\"1-3-2\">\n            <span data-kid=\"1-3-2-1\">\n                Kebab Sufi · Orihuela\n            </span>\n            <span data-kid=\"1-3-2-2\">\n                +34 966 34 41 88\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    const toggle = document.getElementById('specialty-toggle');\n  const panel = document.getElementById('specialty-panel');\n  toggle?.addEventListener('click', () => {\n    const open = toggle.getAttribute('aria-expanded') === 'true';\n    toggle.setAttribute('aria-expanded', String(!open));\n    toggle.querySelector('i').className = open ? 'ti ti-plus' : 'ti ti-minus';\n    toggle.querySelector('span').textContent = open ? 'Ver qué preparamos' : 'Ocultar selección';\n    panel.classList.toggle('is-open', !open);\n  });\n</script>\n",
