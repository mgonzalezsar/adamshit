      "html": "<link data-kid=\"1\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');\n\n  .site-shell {\n    --ink: #12110e;\n    --ink-soft: #1b1914;\n    --paper: #f1efe9;\n    --paper-deep: #e7e3da;\n    --pepper: #b83a24;\n    --pepper-dark: #812718;\n    --brass: #c4944e;\n    --line: rgba(18, 17, 14, .20);\n    --muted: #66635c;\n    color: var(--ink);\n    background: var(--paper);\n    font-family: 'DM Sans', Arial, sans-serif;\n    min-height: 100vh;\n    overflow-x: hidden;\n  }\n\n  .display-font { font-family: 'Barlow Condensed', Impact, sans-serif; }\n  .mono-font { font-variant-numeric: tabular-nums; }\n  .ti { display: inline-flex; width: 1.1em; height: 1.1em; align-items: center; justify-content: center; color: currentColor; }\n  .site-shell a, .site-shell button { -webkit-tap-highlight-color: transparent; }\n  .site-shell :focus-visible { outline: 2px solid var(--brass); outline-offset: 4px; }\n\n  .topbar {\n    background: var(--ink);\n    color: var(--paper);\n    min-height: 76px;\n    border-bottom: 1px solid rgba(241, 239, 233, .12);\n  }\n  .topbar-inner { max-width: 1240px; margin: 0 auto; padding: 0 34px; min-height: 76px; }\n  .wordmark { letter-spacing: -.055em; line-height: .78; }\n  .wordmark-small { font-size: 14px; letter-spacing: .18em; color: var(--brass); }\n  .nav-link { color: rgba(241,239,233,.72); font-size: 13px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; transition: color .2s ease; }\n  .nav-link:hover { color: var(--paper); }\n  .call-top { border: 1px solid rgba(241,239,233,.35); color: var(--paper); transition: background .2s ease, border-color .2s ease, color .2s ease; }\n  .call-top:hover { color: var(--ink); background: var(--brass); border-color: var(--brass); }\n\n  .hero { min-height: 520px; position: relative; isolation: isolate; background: var(--ink); color: var(--paper); }\n  .hero-image { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 55%; filter: saturate(.96) contrast(1.06); }\n  .hero-scrim { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(18,17,14,.84), rgba(18,17,14,.55) 48%, rgba(18,17,14,.78)); }\n  .hero-scrim::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(18,17,14,.15), rgba(18,17,14,.74)); }\n  .hero-inner { max-width: 1240px; min-height: 520px; margin: 0 auto; padding: 58px 34px 48px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }\n  .eyebrow { color: var(--brass); font-size: 12px; line-height: 1; letter-spacing: .26em; font-weight: 700; text-transform: uppercase; }\n  .hero-title { font-size: clamp(74px, 10vw, 140px); line-height: .77; letter-spacing: -.04em; text-transform: uppercase; margin: 18px 0 0; text-shadow: 0 2px 0 rgba(0,0,0,.2); }\n  .hero-title span { display: block; color: var(--brass); font-size: .49em; line-height: .95; letter-spacing: .075em; margin-top: 11px; }\n  .hero-meta { margin-top: 28px; display: flex; gap: 18px; align-items: center; justify-content: center; flex-wrap: wrap; color: rgba(241,239,233,.94); font-size: 15px; }\n  .hero-meta strong { color: var(--paper); font-weight: 700; }\n  .meta-divider { width: 4px; height: 4px; border-radius: 999px; background: var(--brass); }\n  .hero-actions { margin-top: 34px; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }\n  .action { min-height: 48px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 0 23px; border-radius: 8px; font-size: 14px; font-weight: 700; text-decoration: none; transition: transform .2s ease, background .2s ease, color .2s ease, border-color .2s ease; }\n  .action:hover { transform: translateY(-2px); }\n  .action-primary { color: var(--paper); background: var(--pepper); border: 1px solid var(--pepper); }\n  .action-primary:hover { background: var(--pepper-dark); border-color: var(--pepper-dark); }\n  .action-light { color: var(--ink); background: var(--paper); border: 1px solid var(--paper); }\n  .action-light:hover { color: var(--paper); background: transparent; }\n  .action-quiet { color: var(--paper); background: rgba(18,17,14,.72); border: 1px solid rgba(241,239,233,.46); }\n  .action-quiet:hover { border-color: var(--brass); color: var(--brass); }\n  .scroll-mark { margin-top: 44px; display: inline-flex; align-items: center; gap: 10px; color: rgba(241,239,233,.66); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; }\n  .scroll-mark::before { content: ''; width: 32px; height: 1px; background: var(--brass); }\n\n  .speciality-strip { border-bottom: 1px solid var(--line); background: var(--paper); }\n  .speciality-inner { max-width: 1240px; margin: 0 auto; padding: 20px 34px; display: flex; justify-content: space-between; align-items: center; gap: 24px; }\n  .speciality-list { display: flex; align-items: center; flex-wrap: wrap; gap: 0; font-family: 'Barlow Condensed', Impact, sans-serif; font-size: 24px; line-height: 1; letter-spacing: .03em; text-transform: uppercase; }\n  .speciality-list span:not(:last-child)::after { content: '·'; color: var(--pepper); margin: 0 12px; }\n  .speciality-note { color: var(--muted); font-size: 13px; white-space: nowrap; }\n  .speciality-toggle { color: var(--pepper); border: 0; background: none; font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }\n  .speciality-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .35s ease; background: var(--paper-deep); }\n  .speciality-panel-inner { overflow: hidden; }\n  .speciality-panel.open { grid-template-rows: 1fr; }\n  .speciality-panel p { max-width: 1240px; margin: 0 auto; padding: 0 34px; color: var(--ink); font-size: 15px; line-height: 1.6; }\n  .speciality-panel.open p { padding-top: 16px; padding-bottom: 16px; }\n\n  .info-section { background: var(--paper); }\n  .info-grid { max-width: 1240px; min-height: 610px; margin: 0 auto; padding: 88px 34px 96px; display: grid; grid-template-columns: 1fr 1fr; }\n  .info-column { padding: 0 76px; }\n  .info-column + .info-column { border-left: 1px solid var(--line); }\n  .section-kicker { color: var(--pepper); font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .20em; }\n  .section-title { font-size: clamp(54px, 5vw, 84px); line-height: .86; letter-spacing: -.035em; text-transform: uppercase; margin: 14px 0 42px; }\n  .hours-lead { color: var(--muted); margin: 0 0 18px; font-size: 16px; }\n  .hours-big { display: grid; gap: 11px; margin: 0; }\n  .hours-band { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 17px 18px; border-left: 5px solid var(--pepper); background: rgba(184,58,36,.09); }\n  .hours-band dt { color: var(--pepper); font-family: 'Barlow Condensed', Impact, sans-serif; font-size: 22px; letter-spacing: .06em; text-transform: uppercase; }\n  .hours-band dd { margin: 0; color: var(--ink); font-family: 'DM Sans', Arial, sans-serif; font-size: 19px; font-weight: 700; font-variant-numeric: tabular-nums; }\n  .hours-foot { margin: 28px 0 0; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; }\n  .hours-foot strong { color: var(--ink); }\n  .address-block { display: flex; gap: 14px; align-items: flex-start; }\n  .address-icon { color: var(--pepper); font-size: 24px; margin-top: 2px; }\n  .address-copy { margin: 0; font-family: 'Barlow Condensed', Impact, sans-serif; font-size: 32px; line-height: .98; letter-spacing: .01em; }\n  .address-copy span { display: block; }\n  .address-sub { margin: 15px 0 0 38px; color: var(--muted); font-size: 14px; }\n  .location-actions { display: flex; align-items: center; gap: 18px; margin: 28px 0 34px 38px; flex-wrap: wrap; }\n  .copy-button { border: 0; background: none; color: var(--ink); font-size: 13px; font-weight: 700; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }\n  .copy-button:hover { color: var(--pepper); }\n  .route-link { color: var(--pepper); font-size: 14px; font-weight: 700; text-decoration: none; border-bottom: 1px solid var(--pepper); padding-bottom: 4px; }\n  .route-link:hover { color: var(--pepper-dark); border-color: var(--pepper-dark); }\n  .service-list { margin: 0 0 0 38px; padding: 24px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 16px 28px; list-style: none; }\n  .service-list li { display: flex; align-items: center; gap: 10px; color: var(--ink); font-size: 14px; }\n  .service-list li::before { content: ''; width: 8px; height: 8px; flex: 0 0 8px; background: var(--brass); border-radius: 50%; }\n  .service-list li:last-child::before { background: var(--pepper); }\n  .terrace-note { margin: 28px 0 0 38px; color: var(--muted); font-size: 14px; }\n  .terrace-note strong { color: var(--ink); }\n\n  .footer { position: relative; overflow: hidden; background: var(--ink); color: var(--paper); }\n  .footer::after { content: ''; position: absolute; width: 520px; height: 520px; right: -130px; top: -70px; border-radius: 50%; background: radial-gradient(circle, rgba(196,148,78,.14), rgba(196,148,78,0) 68%); pointer-events: none; }\n  .footer-inner { position: relative; z-index: 1; max-width: 1240px; min-height: 400px; margin: 0 auto; padding: 76px 34px 28px; }\n  .footer-grid { display: grid; grid-template-columns: 1.1fr .8fr 1.15fr; gap: 72px; }\n  .footer-brand { font-size: 37px; line-height: .82; letter-spacing: -.03em; text-transform: uppercase; }\n  .footer-brand span { display: block; color: var(--brass); font-size: .54em; letter-spacing: .11em; margin-top: 13px; }\n  .footer-copy { max-width: 230px; color: rgba(241,239,233,.66); font-size: 14px; line-height: 1.55; margin: 25px 0 20px; }\n  .footer-contact { color: var(--paper); font-size: 14px; font-weight: 700; text-decoration: none; }\n  .footer-contact:hover { color: var(--brass); }\n  .footer-heading { margin: 0 0 22px; color: var(--brass); font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }\n  .footer-links { display: grid; gap: 13px; }\n  .footer-links a { color: rgba(241,239,233,.70); font-size: 14px; text-decoration: none; }\n  .footer-links a:hover { color: var(--paper); }\n  .footer-cta-label { margin: 0 0 10px; color: var(--brass); font-size: 12px; letter-spacing: .20em; text-transform: uppercase; }\n  .footer-cta { max-width: 390px; margin: 0; font-size: clamp(45px, 4.3vw, 68px); line-height: .84; letter-spacing: -.035em; text-transform: uppercase; }\n  .footer-button { margin-top: 28px; }\n  .footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 22px; margin-top: 66px; border-top: 1px solid rgba(241,239,233,.17); color: rgba(241,239,233,.48); font-size: 12px; }\n\n  @media (max-width: 900px) {\n    .topbar-inner, .hero-inner, .speciality-inner, .info-grid, .footer-inner { padding-left: 24px; padding-right: 24px; }\n    .nav-links { display: none; }\n    .hero-title { font-size: clamp(72px, 15vw, 120px); }\n    .info-grid { grid-template-columns: 1fr; padding-top: 70px; padding-bottom: 70px; gap: 68px; }\n    .info-column { padding: 0; }\n    .info-column + .info-column { border-left: 0; border-top: 1px solid var(--line); padding-top: 68px; }\n    .footer-grid { grid-template-columns: 1fr 1fr; gap: 52px 40px; }\n    .footer-grid > :last-child { grid-column: 1 / -1; }\n  }\n  @media (max-width: 620px) {\n    .topbar, .topbar-inner { min-height: 68px; }\n    .topbar-inner { padding-left: 18px; padding-right: 18px; }\n    .wordmark { font-size: 30px; }\n    .wordmark-small { font-size: 10px; }\n    .call-top { width: 40px; height: 40px; padding: 0; border-radius: 50%; font-size: 0; }\n    .call-top .ti { font-size: 17px; }\n    .hero { min-height: 560px; }\n    .hero-inner { min-height: 560px; padding: 48px 18px 32px; }\n    .hero-title { font-size: 82px; }\n    .hero-meta { gap: 10px; font-size: 13px; }\n    .hero-actions { width: 100%; gap: 9px; }\n    .action { width: 100%; max-width: 300px; }\n    .scroll-mark { margin-top: 30px; }\n    .speciality-inner { padding: 18px; align-items: flex-start; flex-direction: column; gap: 12px; }\n    .speciality-list { font-size: 22px; }\n    .speciality-note { white-space: normal; }\n    .info-grid { padding: 58px 18px 70px; gap: 55px; }\n    .section-title { font-size: 64px; margin-bottom: 32px; }\n    .hours-band { display: block; padding: 15px; }\n    .hours-band dd { margin-top: 5px; font-size: 18px; }\n    .address-copy { font-size: 29px; }\n    .service-list { grid-template-columns: 1fr; }\n    .footer-inner { padding: 58px 18px 22px; }\n    .footer-grid { grid-template-columns: 1fr; gap: 44px; }\n    .footer-grid > :last-child { grid-column: auto; }\n    .footer-bottom { margin-top: 48px; flex-direction: column; gap: 8px; }\n  }\n</style>\n<div class=\"site-shell\" data-kid=\"2\">\n    <header class=\"topbar\" data-kid=\"2-1\" id=\"inicio\">\n        <div class=\"topbar-inner flex items-center justify-between\" data-kid=\"2-1-1\">\n            <a aria-label=\"Kebab Sufi Orihuela, inicio\" class=\"no-underline text-inherit flex flex-col gap-1\" data-kid=\"2-1-1-1\" href=\"#inicio\">\n                <span class=\"display-font wordmark text-[38px] font-bold uppercase\" data-kid=\"2-1-1-1-1\">\n                    Kebab Sufi\n                </span>\n                <span class=\"wordmark-small\" data-kid=\"2-1-1-1-2\">\n                    Orihuela · comida turca\n                </span>\n            </a>\n            <div class=\"flex items-center gap-7\" data-kid=\"2-1-1-2\">\n                <nav aria-label=\"Navegación principal\" class=\"nav-links flex items-center gap-7\" data-kid=\"2-1-1-2-1\">\n                    <a class=\"nav-link no-underline\" data-kid=\"2-1-1-2-1-1\" href=\"#especialidades\">\n                        Especialidades\n                    </a>\n                    <a class=\"nav-link no-underline\" data-kid=\"2-1-1-2-1-2\" href=\"#horario\">\n                        Horario\n                    </a>\n                    <a class=\"nav-link no-underline\" data-kid=\"2-1-1-2-1-3\" href=\"#ubicacion\">\n                        Ubicación\n                    </a>\n                </nav>\n                <a aria-label=\"Llamar al Kebab Sufi\" class=\"call-top inline-flex items-center gap-2 rounded-md px-4 py-3 no-underline text-sm font-bold\" data-kid=\"2-1-1-2-2\" href=\"tel:+34966344188\">\n                    <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"2-1-1-2-2-1\">\n                    </i>\n                    <span data-kid=\"2-1-1-2-2-2\">\n                        +34 966 34 41 88\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"2-2\">\n        <section aria-labelledby=\"hero-title\" class=\"hero\" data-kid=\"2-2-1\">\n            <img alt=\"Plato de pollo crujiente con patatas y salsa en Kebab Sufi Orihuela\" class=\"hero-image\" data-kid=\"2-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.toppingsandsalads.es/images/a59e150a0c800dce69c28a5a65dc06d0.jpg\"/>\n            <div aria-hidden=\"true\" class=\"hero-scrim\" data-kid=\"2-2-1-2\">\n            </div>\n            <div class=\"hero-inner\" data-kid=\"2-2-1-3\">\n                <p class=\"eyebrow m-0\" data-kid=\"2-2-1-3-1\">\n                    Carne fresca · salsa blanca · terraza\n                </p>\n                <h1 class=\"display-font hero-title font-bold\" data-kid=\"2-2-1-3-2\" id=\"hero-title\">\n                    Kebab Sufi\n                    <span data-kid=\"2-2-1-3-2-1\">\n                        Orihuela\n                    </span>\n                </h1>\n                <div class=\"hero-meta\" data-kid=\"2-2-1-3-3\">\n                    <span data-kid=\"2-2-1-3-3-1\">\n                        <strong data-kid=\"2-2-1-3-3-1-1\">\n                            Horario de hoy\n                        </strong>\n                        · 12:00–16:00 · 18:00–00:30\n                    </span>\n                    <span aria-hidden=\"true\" class=\"meta-divider\" data-kid=\"2-2-1-3-3-2\">\n                    </span>\n                    <span data-kid=\"2-2-1-3-3-3\">\n                        <strong data-kid=\"2-2-1-3-3-3-1\">\n                            8,4\n                        </strong>\n                        · 762 reseñas\n                    </span>\n                </div>\n                <div aria-label=\"Acciones principales\" class=\"hero-actions\" data-kid=\"2-2-1-3-4\">\n                    <a class=\"action action-primary\" data-kid=\"2-2-1-3-4-1\" href=\"#especialidades\">\n                        <i aria-hidden=\"true\" class=\"ti ti-tools-kitchen-2\" data-kid=\"2-2-1-3-4-1-1\">\n                        </i>\n                        <span data-kid=\"2-2-1-3-4-1-2\">\n                            Ver especialidades\n                        </span>\n                    </a>\n                    <a class=\"action action-light\" data-kid=\"2-2-1-3-4-2\" href=\"tel:+34966344188\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"2-2-1-3-4-2-1\">\n                        </i>\n                        <span data-kid=\"2-2-1-3-4-2-2\">\n                            Llamar al local\n                        </span>\n                    </a>\n                    <a class=\"action action-quiet\" data-kid=\"2-2-1-3-4-3\" data-name=\"how-to-get-there action button\" href=\"https://www.google.com/maps/search/?api=1&query=C.%20Duque%20de%20Tamames%2C%2020%2C%20Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                        <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"2-2-1-3-4-3-1\">\n                        </i>\n                        <span data-kid=\"2-2-1-3-4-3-2\">\n                            Cómo llegar\n                        </span>\n                    </a>\n                </div>\n                <a class=\"scroll-mark no-underline\" data-kid=\"2-2-1-3-5\" href=\"#horario\">\n                    Descubre el local\n                </a>\n            </div>\n        </section>\n        <section aria-label=\"Especialidades del local\" class=\"speciality-strip\" data-kid=\"2-2-2\" id=\"especialidades\">\n            <div class=\"speciality-inner\" data-kid=\"2-2-2-1\">\n                <div aria-label=\"Oferta gastronómica\" class=\"speciality-list\" data-kid=\"2-2-2-1-1\">\n                    <span data-kid=\"2-2-2-1-1-1\">\n                        Kebab\n                    </span>\n                    <span data-kid=\"2-2-2-1-1-2\">\n                        Dürüm\n                    </span>\n                    <span data-kid=\"2-2-2-1-1-3\">\n                        Hamburguesas\n                    </span>\n                    <span data-kid=\"2-2-2-1-1-4\">\n                        Alitas\n                    </span>\n                    <span data-kid=\"2-2-2-1-1-5\">\n                        Patatas\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-4\" data-kid=\"2-2-2-1-2\">\n                    <span class=\"speciality-note\" data-kid=\"2-2-2-1-2-1\">\n                        Carne fresca y salsa blanca\n                    </span>\n                    <button aria-controls=\"speciality-panel\" aria-expanded=\"false\" class=\"speciality-toggle\" data-dynamic=\"true\" data-kid=\"2-2-2-1-2-2\" data-name=\"specialty details toggle button\" data-reason=\"text and aria-expanded state updated by script on click\" type=\"button\">\n                        Ver más\n                    </button>\n                </div>\n            </div>\n            <div class=\"speciality-panel\" data-kid=\"2-2-2-2\" id=\"speciality-panel\">\n                <div class=\"speciality-panel-inner\" data-kid=\"2-2-2-2-1\">\n                    <p data-kid=\"2-2-2-2-1-1\">\n                        Una carta directa para comer aquí, pedir para llevar o disfrutar de la terraza: kebab, dürüm, hamburguesas, alitas y patatas con porciones generosas y trato cercano.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"info-section\" data-kid=\"2-2-3\" id=\"horario\">\n            <div class=\"info-grid\" data-kid=\"2-2-3-1\">\n                <article aria-labelledby=\"hours-title\" class=\"info-column\" data-kid=\"2-2-3-1-1\">\n                    <p class=\"section-kicker m-0\" data-kid=\"2-2-3-1-1-1\">\n                        Sin prisas, todos los días\n                    </p>\n                    <h2 class=\"display-font section-title font-bold\" data-kid=\"2-2-3-1-1-2\" id=\"hours-title\">\n                        Horario\n                    </h2>\n                    <p class=\"hours-lead\" data-kid=\"2-2-3-1-1-3\">\n                        Abrimos al mediodía y volvemos para la cena.\n                    </p>\n                    <dl class=\"hours-big\" data-kid=\"2-2-3-1-1-4\">\n                        <div class=\"hours-band\" data-kid=\"2-2-3-1-1-4-1\">\n                            <dt data-kid=\"2-2-3-1-1-4-1-1\">\n                                Mediodía\n                            </dt>\n                            <dd data-kid=\"2-2-3-1-1-4-1-2\">\n                                12:00 — 16:00\n                            </dd>\n                        </div>\n                        <div class=\"hours-band\" data-kid=\"2-2-3-1-1-4-2\">\n                            <dt data-kid=\"2-2-3-1-1-4-2-1\">\n                                Noche\n                            </dt>\n                            <dd data-kid=\"2-2-3-1-1-4-2-2\">\n                                18:00 — 00:30\n                            </dd>\n                        </div>\n                    </dl>\n                    <p class=\"hours-foot\" data-kid=\"2-2-3-1-1-5\">\n                        <strong data-kid=\"2-2-3-1-1-5-1\">\n                            Todos los días.\n                        </strong>\n                        Mismo horario de lunes a domingo.\n                    </p>\n                </article>\n                <article aria-labelledby=\"location-title\" class=\"info-column\" data-kid=\"2-2-3-1-2\" id=\"ubicacion\">\n                    <p class=\"section-kicker m-0\" data-kid=\"2-2-3-1-2-1\">\n                        Ven a vernos en el centro\n                    </p>\n                    <h2 class=\"display-font section-title font-bold\" data-kid=\"2-2-3-1-2-2\" id=\"location-title\">\n                        Ubicación\n                    </h2>\n                    <div class=\"address-block\" data-kid=\"2-2-3-1-2-3\">\n                        <i aria-hidden=\"true\" class=\"ti ti-map-pin address-icon\" data-kid=\"2-2-3-1-2-3-1\">\n                        </i>\n                        <p class=\"address-copy\" data-kid=\"2-2-3-1-2-3-2\">\n                            <span data-kid=\"2-2-3-1-2-3-2-1\">\n                                C. Duque de Tamames, 20\n                            </span>\n                            <span data-kid=\"2-2-3-1-2-3-2-2\">\n                                03300 Orihuela, Alicante\n                            </span>\n                        </p>\n                    </div>\n                    <p class=\"address-sub\" data-kid=\"2-2-3-1-2-4\">\n                        Calle Duque de Tamames · Orihuela\n                    </p>\n                    <div class=\"location-actions\" data-kid=\"2-2-3-1-2-5\">\n                        <button class=\"copy-button\" data-copy-address=\"C. Duque de Tamames, 20, 03300 Orihuela, Alicante\" data-dynamic=\"true\" data-kid=\"2-2-3-1-2-5-1\" data-name=\"copy address button\" data-reason=\"text and inner content updated by script on click\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-copy\" data-kid=\"2-2-3-1-2-5-1-1\">\n                            </i>\n                            Copiar dirección\n                        </button>\n                        <a class=\"route-link\" data-kid=\"2-2-3-1-2-5-2\" href=\"https://www.google.com/maps/search/?api=1&query=C.%20Duque%20de%20Tamames%2C%2020%2C%20Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                            <i aria-hidden=\"true\" class=\"ti ti-navigation\" data-kid=\"2-2-3-1-2-5-2-1\">\n                            </i>\n                            Abrir indicaciones\n                        </a>\n                    </div>\n                    <ul aria-label=\"Servicios disponibles\" class=\"service-list\" data-kid=\"2-2-3-1-2-6\">\n                        <li data-kid=\"2-2-3-1-2-6-1\">\n                            Comer en el local\n                        </li>\n                        <li data-kid=\"2-2-3-1-2-6-2\">\n                            Para llevar\n                        </li>\n                        <li data-kid=\"2-2-3-1-2-6-3\">\n                            Entrega a domicilio\n                        </li>\n                        <li data-kid=\"2-2-3-1-2-6-4\">\n                            Terraza\n                        </li>\n                        <li data-kid=\"2-2-3-1-2-6-5\">\n                            Entrada accesible\n                        </li>\n                    </ul>\n                    <p class=\"terrace-note\" data-kid=\"2-2-3-1-2-7\">\n                        <strong data-kid=\"2-2-3-1-2-7-1\">\n                            ¿Plan tranquilo?\n                        </strong>\n                        También hay terraza.\n                    </p>\n                </article>\n            </div>\n        </section>\n    </main>\n    <footer class=\"footer\" data-kid=\"2-3\">\n        <div class=\"footer-inner\" data-kid=\"2-3-1\">\n            <div class=\"footer-grid\" data-kid=\"2-3-1-1\">\n                <div data-kid=\"2-3-1-1-1\">\n                    <p class=\"display-font footer-brand font-bold m-0\" data-kid=\"2-3-1-1-1-1\">\n                        Kebab Sufi\n                        <span data-kid=\"2-3-1-1-1-1-1\">\n                            Orihuela\n                        </span>\n                    </p>\n                    <p class=\"footer-copy\" data-kid=\"2-3-1-1-1-2\">\n                        Comer aquí, para llevar o a domicilio. Sabor turco, raciones generosas y trato cercano.\n                    </p>\n                    <a class=\"footer-contact\" data-kid=\"2-3-1-1-1-3\" href=\"tel:+34966344188\">\n                        <i aria-hidden=\"true\" class=\"ti ti-phone\" data-kid=\"2-3-1-1-1-3-1\">\n                        </i>\n                        +34 966 34 41 88\n                    </a>\n                    <div class=\"mt-5\" data-kid=\"2-3-1-1-1-4\">\n                        <a class=\"footer-contact\" data-kid=\"2-3-1-1-1-4-1\" href=\"https://www.instagram.com/pak_orihuela_kebab/\" rel=\"noreferrer\" target=\"_blank\">\n                            <i aria-hidden=\"true\" class=\"ti ti-brand-instagram\" data-kid=\"2-3-1-1-1-4-1-1\">\n                            </i>\n                            Instagram\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"2-3-1-1-2\">\n                    <p class=\"footer-heading\" data-kid=\"2-3-1-1-2-1\">\n                        Antes de venir\n                    </p>\n                    <nav aria-label=\"Enlaces del local\" class=\"footer-links\" data-kid=\"2-3-1-1-2-2\">\n                        <a data-kid=\"2-3-1-1-2-2-1\" href=\"#especialidades\">\n                            Especialidades\n                        </a>\n                        <a data-kid=\"2-3-1-1-2-2-2\" href=\"#horario\">\n                            Horario\n                        </a>\n                        <a data-kid=\"2-3-1-1-2-2-3\" href=\"#ubicacion\">\n                            Ubicación\n                        </a>\n                        <a data-kid=\"2-3-1-1-2-2-4\" href=\"#ubicacion\">\n                            Entrada accesible\n                        </a>\n                    </nav>\n                </div>\n                <div data-kid=\"2-3-1-1-3\">\n                    <p class=\"footer-cta-label\" data-kid=\"2-3-1-1-3-1\">\n                        Orihuela, Alicante\n                    </p>\n                    <p class=\"display-font footer-cta font-bold\" data-kid=\"2-3-1-1-3-2\">\n                        La cena sigue en Duque de Tamames.\n                    </p>\n                    <a class=\"action action-primary footer-button\" data-kid=\"2-3-1-1-3-3\" href=\"https://www.google.com/maps/search/?api=1&query=C.%20Duque%20de%20Tamames%2C%2020%2C%20Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                        <i aria-hidden=\"true\" class=\"ti ti-route\" data-kid=\"2-3-1-1-3-3-1\">\n                        </i>\n                        <span data-kid=\"2-3-1-1-3-3-2\">\n                            Abrir indicaciones\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"footer-bottom\" data-kid=\"2-3-1-2\">\n                <span data-kid=\"2-3-1-2-1\">\n                    © 2026 Kebab Sufi Orihuela\n                </span>\n                <span data-kid=\"2-3-1-2-2\">\n                    C. Duque de Tamames, 20 · Orihuela\n                </span>\n            </div>\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n    const toggle = document.querySelector('.speciality-toggle');\n    const panel = document.querySelector('#speciality-panel');\n    if (toggle && panel) toggle.addEventListener('click', () => {\n      const open = panel.classList.toggle('open');\n      toggle.setAttribute('aria-expanded', String(open));\n      toggle.textContent = open ? 'Ocultar' : 'Ver más';\n    });\n    document.querySelectorAll('[data-copy-address]').forEach((button) => button.addEventListener('click', async () => {\n      const value = button.getAttribute('data-copy-address');\n      try { await navigator.clipboard.writeText(value); button.innerHTML = '<i class=\"ti ti-check\" aria-hidden=\"true\"></i> Dirección copiada'; setTimeout(() => { button.innerHTML = '<i class=\"ti ti-copy\" aria-hidden=\"true\"></i> Copiar dirección'; }, 1800); }\n      catch (error) { button.textContent = 'Selecciona la dirección'; }\n    }));\n  })();\n</script>\n",
