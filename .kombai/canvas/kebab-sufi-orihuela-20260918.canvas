      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n  :root {\n    --ink: #1d211d;\n    --ink-deep: #0b0c0a;\n    --paper: #e6e5de;\n    --paper-soft: #f0efe9;\n    --harissa: #a82e23;\n    --pickle: #728043;\n    --line: rgba(29, 33, 29, .32);\n    --line-light: rgba(230, 229, 222, .22);\n  }\n  html { scroll-behavior: smooth; }\n  .display { font-family: 'Barlow Condensed', Impact, sans-serif; letter-spacing: -.025em; }\n  .mono { font-family: 'IBM Plex Mono', 'Courier New', monospace; }\n  .ui { font-family: 'Space Grotesk', Arial, sans-serif; }\n  .ticket-edge { position: relative; }\n  .ticket-edge::before, .ticket-edge::after { content: ''; position: absolute; left: 0; right: 0; height: 1px; background-image: repeating-linear-gradient(90deg, currentColor 0 7px, transparent 7px 13px); opacity: .38; }\n  .ticket-edge::before { top: 0; }\n  .ticket-edge::after { bottom: 0; }\n  .selection-copy { max-height: 0; overflow: hidden; opacity: 0; transition: max-height .35s ease, opacity .25s ease; }\n  .selection-copy.is-open { max-height: 160px; opacity: 1; }\n  .copy-feedback { min-width: 146px; }\n  @media (max-width: 760px) {\n    .desktop-nav { display: none; }\n    .hero-title { font-size: 82px !important; line-height: .78 !important; }\n    .hero-actions { grid-template-columns: 1fr !important; width: min(100%, 330px); }\n    .hero-actions a { width: 100%; }\n    .info-grid { grid-template-columns: 1fr !important; }\n    .info-divider { border-left: 0 !important; border-top: 1px solid var(--line); }\n    .footer-grid { grid-template-columns: 1fr !important; }\n  }\n</style>\n<div class=\"m-0 min-h-screen overflow-hidden bg-[var(--paper)] text-[var(--ink)]\" data-kid=\"1\">\n    <header class=\"relative z-20 h-[72px] bg-[var(--ink-deep)] text-[var(--paper)]\" data-kid=\"1-1\">\n        <div class=\"mx-auto flex h-full max-w-[1280px] items-center justify-between px-7 lg:px-10\" data-kid=\"1-1-1\">\n            <a aria-label=\"Kebab Sufi Orihuela, inicio\" class=\"group flex items-center gap-3 no-underline\" data-kid=\"1-1-1-1\" href=\"#top\">\n                <span class=\"display text-[28px] font-extrabold leading-none tracking-[-.02em] text-[var(--paper)]\" data-kid=\"1-1-1-1-1\">\n                    KEBAB SUFI\n                </span>\n                <span class=\"mono border-l border-[var(--line-light)] pl-3 text-[10px] uppercase tracking-[.22em] text-[var(--paper)]/55\" data-kid=\"1-1-1-1-2\">\n                    ORIHUELA\n                </span>\n            </a>\n            <nav aria-label=\"Navegación principal\" class=\"desktop-nav flex items-center gap-8 ui text-[11px] font-semibold uppercase tracking-[.12em] text-[var(--paper)]/72\" data-kid=\"1-1-1-2\">\n                <a class=\"no-underline transition-colors hover:text-[var(--paper)]\" data-kid=\"1-1-1-2-1\" href=\"#selection\">\n                    Selección\n                </a>\n                <a class=\"no-underline transition-colors hover:text-[var(--paper)]\" data-kid=\"1-1-1-2-2\" href=\"#horario\">\n                    Horario\n                </a>\n                <a class=\"no-underline transition-colors hover:text-[var(--paper)]\" data-kid=\"1-1-1-2-3\" href=\"#local\">\n                    El local\n                </a>\n                <a class=\"mono border border-[var(--paper)]/25 px-4 py-2 text-[10px] text-[var(--paper)] no-underline transition-colors hover:border-[var(--harissa)] hover:bg-[var(--harissa)]\" data-kid=\"1-1-1-2-4\" href=\"tel:+34966344188\">\n                    Llamar · 966 34 41 88\n                </a>\n            </nav>\n            <a aria-label=\"Llamar al local\" class=\"ui flex h-9 w-9 items-center justify-center border border-[var(--paper)]/30 text-[var(--paper)] no-underline md:hidden\" data-kid=\"1-1-1-3\" href=\"tel:+34966344188\">\n                <i class=\"ti ti-phone text-[17px]\" data-kid=\"1-1-1-3-1\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" id=\"top\">\n        <section aria-label=\"Presentación de Kebab Sufi\" class=\"relative flex h-[500px] items-center justify-center overflow-hidden bg-[var(--ink-deep)] text-[var(--paper)]\" data-kid=\"1-2-1\">\n            <img alt=\"Pollo crujiente con patatas y salsa en Kebab Sufi Orihuela\" class=\"absolute inset-0 h-full w-full object-cover object-center opacity-75\" data-kid=\"1-2-1-1\" decoding=\"async\" loading=\"lazy\" src=\"https://www.toppingsandsalads.es/images/a59e150a0c800dce69c28a5a65dc06d0.jpg\"/>\n            <div class=\"absolute inset-0 bg-[var(--ink-deep)]/75\" data-kid=\"1-2-1-2\">\n            </div>\n            <div class=\"absolute inset-y-0 left-0 w-[18px] border-r border-[var(--harissa)]/50 bg-[var(--harissa)]/15\" data-kid=\"1-2-1-3\">\n            </div>\n            <div class=\"absolute inset-y-0 right-0 w-[18px] border-l border-[var(--harissa)]/50 bg-[var(--harissa)]/15\" data-kid=\"1-2-1-4\">\n            </div>\n            <div class=\"relative z-10 flex w-full max-w-[920px] flex-col items-center px-6 text-center\" data-kid=\"1-2-1-5\">\n                <div class=\"mono mb-5 flex items-center gap-3 text-[10px] uppercase tracking-[.34em] text-[var(--paper)]/62\" data-kid=\"1-2-1-5-1\">\n                    <span class=\"h-px w-10 bg-[var(--harissa)]\" data-kid=\"1-2-1-5-1-1\">\n                    </span>\n                    <span data-kid=\"1-2-1-5-1-2\">\n                        Comida turca · Orihuela\n                    </span>\n                    <span class=\"h-px w-10 bg-[var(--harissa)]\" data-kid=\"1-2-1-5-1-3\">\n                    </span>\n                </div>\n                <h1 class=\"display hero-title m-0 text-[128px] font-extrabold uppercase leading-[.74] text-[var(--paper)] drop-shadow-[0_5px_0_rgba(11,12,10,.35)]\" data-kid=\"1-2-1-5-2\">\n                    KEBAB SUFI\n                    <br data-kid=\"1-2-1-5-2-1\"/>\n                    <span class=\"text-[var(--harissa)]\" data-kid=\"1-2-1-5-2-2\">\n                        ORIHUELA\n                    </span>\n                </h1>\n                <div class=\"ticket-edge mono mt-7 flex w-[min(100%,530px)] flex-col items-center gap-2 px-8 py-4 text-[var(--paper)]\" data-kid=\"1-2-1-5-3\">\n                    <span class=\"text-[10px] font-semibold uppercase tracking-[.25em] text-[var(--paper)]/65\" data-kid=\"1-2-1-5-3-1\">\n                        Horario de hoy\n                    </span>\n                    <span class=\"text-[17px] font-semibold tracking-[-.04em]\" data-kid=\"1-2-1-5-3-2\">\n                        12:00–16:00\n                        <span class=\"px-2 text-[var(--harissa)]\" data-kid=\"1-2-1-5-3-2-1\">\n                            /\n                        </span>\n                        18:00–00:30\n                    </span>\n                    <span class=\"text-[10px] uppercase tracking-[.18em] text-[var(--paper)]/70\" data-kid=\"1-2-1-5-3-3\">\n                        8,4 · 762 reseñas\n                    </span>\n                </div>\n                <div aria-label=\"Acciones rápidas\" class=\"hero-actions mt-6 grid grid-cols-3 gap-2.5\" data-kid=\"1-2-1-5-4\">\n                    <a class=\"ui flex items-center justify-center gap-2 border border-[var(--harissa)] bg-[var(--harissa)] px-5 py-3 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--paper)] no-underline transition-colors hover:bg-[var(--paper)] hover:text-[var(--ink-deep)]\" data-kid=\"1-2-1-5-4-1\" href=\"#selection\">\n                        <i class=\"ti ti-tools-kitchen-2 text-[15px]\" data-kid=\"1-2-1-5-4-1-1\">\n                        </i>\n                        Ver la selección\n                    </a>\n                    <a class=\"ui flex items-center justify-center gap-2 border border-[var(--paper)] bg-[var(--paper)] px-5 py-3 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--ink-deep)] no-underline transition-colors hover:bg-[var(--harissa)] hover:text-[var(--paper)]\" data-kid=\"1-2-1-5-4-2\" href=\"tel:+34966344188\">\n                        <i class=\"ti ti-phone text-[15px]\" data-kid=\"1-2-1-5-4-2-1\">\n                        </i>\n                        Llamar\n                    </a>\n                    <a class=\"ui flex items-center justify-center gap-2 border border-[var(--paper)]/50 px-5 py-3 text-[11px] font-bold uppercase tracking-[.08em] text-[var(--paper)] no-underline transition-colors hover:border-[var(--harissa)] hover:text-[var(--harissa)]\" data-kid=\"1-2-1-5-4-3\" href=\"https://www.google.com/maps/search/?api=1&query=C.+Duque+de+Tamames+20,+Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                        <i class=\"ti ti-navigation text-[15px]\" data-kid=\"1-2-1-5-4-3-1\">\n                        </i>\n                        Cómo llegar\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section class=\"border-b border-[var(--ink)]/15 bg-[var(--harissa)] text-[var(--paper)]\" data-kid=\"1-2-2\" id=\"selection\">\n            <div class=\"mx-auto flex min-h-[76px] max-w-[1280px] items-center justify-between gap-6 px-7 py-4 lg:px-10\" data-kid=\"1-2-2-1\">\n                <p class=\"mono m-0 text-[12px] font-semibold uppercase leading-6 tracking-[.12em] text-[var(--paper)]\" data-kid=\"1-2-2-1-1\">\n                    KEBAB\n                    <span class=\"px-2 text-[var(--ink)]\" data-kid=\"1-2-2-1-1-1\">\n                        /\n                    </span>\n                    DÜRÜM\n                    <span class=\"px-2 text-[var(--ink)]\" data-kid=\"1-2-2-1-1-2\">\n                        /\n                    </span>\n                    HAMBURGUESAS\n                    <span class=\"px-2 text-[var(--ink)]\" data-kid=\"1-2-2-1-1-3\">\n                        /\n                    </span>\n                    ALITAS\n                    <span class=\"px-2 text-[var(--ink)]\" data-kid=\"1-2-2-1-1-4\">\n                        /\n                    </span>\n                    PATATAS\n                </p>\n                <button aria-controls=\"selection-panel\" aria-expanded=\"false\" class=\"mono shrink-0 border-b border-[var(--paper)]/65 pb-1 text-[10px] uppercase tracking-[.16em] text-[var(--paper)] transition-colors hover:border-[var(--paper)]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-2\" data-name=\"selection details toggle button\" data-reason=\"text content toggled between 'Ver detalles +' and 'Ocultar detalles −' by click script\" id=\"selection-toggle\" type=\"button\">\n                    Ver detalles +\n                </button>\n            </div>\n            <div aria-hidden=\"true\" class=\"selection-copy border-t border-[var(--paper)]/20 bg-[var(--harissa)]\" data-kid=\"1-2-2-2\" id=\"selection-panel\">\n                <div class=\"mx-auto max-w-[1280px] px-7 pb-5 pt-4 lg:px-10\" data-kid=\"1-2-2-2-1\">\n                    <p class=\"ui m-0 max-w-[760px] text-[15px] leading-7 text-[var(--paper)]/88\" data-kid=\"1-2-2-2-1-1\">\n                        Carne fresca, salsa blanca y raciones generosas. Come aquí, recoge tu pedido o pide a domicilio.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section aria-label=\"Información práctica\" class=\"relative bg-[var(--paper)] px-7 py-20 lg:px-10 lg:py-24\" data-kid=\"1-2-3\">\n            <div class=\"info-grid mx-auto grid max-w-[1280px] grid-cols-[1.05fr_.95fr]\" data-kid=\"1-2-3-1\">\n                <article class=\"relative overflow-hidden pr-10 lg:pr-20\" data-kid=\"1-2-3-1-1\" id=\"horario\">\n                    <span aria-hidden=\"true\" class=\"display pointer-events-none absolute -left-2 -top-12 text-[220px] font-extrabold leading-none text-[var(--ink)]/[.055]\" data-kid=\"1-2-3-1-1-1\">\n                        12\n                    </span>\n                    <div class=\"relative\" data-kid=\"1-2-3-1-1-2\">\n                        <p class=\"mono mb-5 text-[10px] font-semibold uppercase tracking-[.24em] text-[var(--harissa)]\" data-kid=\"1-2-3-1-1-2-1\">\n                            01 · Cuándo venir\n                        </p>\n                        <h2 class=\"display m-0 text-[80px] font-extrabold uppercase leading-[.8] tracking-[-.02em] text-[var(--ink)]\" data-kid=\"1-2-3-1-1-2-2\">\n                            Horario\n                        </h2>\n                        <div class=\"mt-12 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-1-2-3\">\n                            <p class=\"mono m-0 text-[12px] uppercase tracking-[.16em] text-[var(--ink)]/65\" data-kid=\"1-2-3-1-1-2-3-1\">\n                                Todos los días\n                            </p>\n                            <div class=\"mt-7 grid gap-4\" data-kid=\"1-2-3-1-1-2-3-2\">\n                                <div class=\"flex items-end justify-between border-b border-[var(--line)] pb-4\" data-kid=\"1-2-3-1-1-2-3-2-1\">\n                                    <span class=\"mono text-[11px] uppercase tracking-[.14em] text-[var(--ink)]/60\" data-kid=\"1-2-3-1-1-2-3-2-1-1\">\n                                        Mediodía\n                                    </span>\n                                    <strong class=\"mono text-[24px] font-semibold tracking-[-.07em]\" data-kid=\"1-2-3-1-1-2-3-2-1-2\">\n                                        12:00–16:00\n                                    </strong>\n                                </div>\n                                <div class=\"flex items-end justify-between border-b border-[var(--line)] pb-4\" data-kid=\"1-2-3-1-1-2-3-2-2\">\n                                    <span class=\"mono text-[11px] uppercase tracking-[.14em] text-[var(--ink)]/60\" data-kid=\"1-2-3-1-1-2-3-2-2-1\">\n                                        Noche\n                                    </span>\n                                    <strong class=\"mono text-[24px] font-semibold tracking-[-.07em]\" data-kid=\"1-2-3-1-1-2-3-2-2-2\">\n                                        18:00–00:30\n                                    </strong>\n                                </div>\n                            </div>\n                            <p class=\"mono mt-7 flex items-center gap-3 text-[11px] uppercase tracking-[.1em] text-[var(--pickle)]\" data-kid=\"1-2-3-1-1-2-3-3\">\n                                <span class=\"h-2 w-2 rounded-full bg-[var(--pickle)]\" data-kid=\"1-2-3-1-1-2-3-3-1\">\n                                </span>\n                                Mismo horario toda la semana\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"info-divider relative border-l border-[var(--harissa)] pl-10 lg:pl-20\" data-kid=\"1-2-3-1-2\" id=\"local\">\n                    <span aria-hidden=\"true\" class=\"display pointer-events-none absolute -right-2 -top-10 text-[220px] font-extrabold leading-none text-[var(--harissa)]/[.07]\" data-kid=\"1-2-3-1-2-1\">\n                        20\n                    </span>\n                    <div class=\"relative\" data-kid=\"1-2-3-1-2-2\">\n                        <p class=\"mono mb-5 text-[10px] font-semibold uppercase tracking-[.24em] text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-1\">\n                            02 · Cómo llegar\n                        </p>\n                        <h2 class=\"display m-0 text-[80px] font-extrabold uppercase leading-[.8] tracking-[-.02em] text-[var(--ink)]\" data-kid=\"1-2-3-1-2-2-2\">\n                            El local\n                        </h2>\n                        <div class=\"mt-12 border-t border-[var(--line)] pt-5\" data-kid=\"1-2-3-1-2-2-3\">\n                            <p class=\"mono m-0 flex items-start gap-3 text-[18px] font-semibold leading-7 tracking-[-.05em]\" data-kid=\"1-2-3-1-2-2-3-1\">\n                                <i class=\"ti ti-map-pin mt-1 text-[20px] text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-1-1\">\n                                </i>\n                                <span data-kid=\"1-2-3-1-2-2-3-1-2\">\n                                    C. Duque de Tamames, 20\n                                    <br data-kid=\"1-2-3-1-2-2-3-1-2-1\"/>\n                                    <span class=\"text-[var(--ink)]/62\" data-kid=\"1-2-3-1-2-2-3-1-2-2\">\n                                        03300 Orihuela, Alicante\n                                    </span>\n                                </span>\n                            </p>\n                            <div class=\"mt-6 flex flex-wrap items-center gap-5 border-b border-[var(--line)] pb-6\" data-kid=\"1-2-3-1-2-2-3-2\">\n                                <a class=\"mono text-[11px] font-semibold uppercase tracking-[.11em] text-[var(--harissa)] underline decoration-1 underline-offset-4 transition-colors hover:text-[var(--ink)]\" data-kid=\"1-2-3-1-2-2-3-2-1\" href=\"https://www.google.com/maps/search/?api=1&query=C.+Duque+de+Tamames+20,+Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                                    Abrir indicaciones\n                                    <i class=\"ti ti-arrow-up-right text-[14px]\" data-kid=\"1-2-3-1-2-2-3-2-1-1\">\n                                    </i>\n                                </a>\n                                <button class=\"copy-feedback mono inline-flex items-center gap-2 border-0 bg-transparent p-0 text-left text-[11px] font-semibold uppercase tracking-[.11em] text-[var(--ink)]/65 transition-colors hover:text-[var(--harissa)]\" data-default=\"Guardar dirección\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-3-2-2\" data-name=\"copy address button\" data-reason=\"text and inner HTML replaced by feedback states after clipboard action\" id=\"copy-address\" type=\"button\">\n                                    <i class=\"ti ti-copy text-[15px]\" data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-3-2-2-1\" data-name=\"copy address icon\" data-reason=\"icon replaced by checkmark icon on success by script\">\n                                    </i>\n                                    <span data-dynamic=\"true\" data-kid=\"1-2-3-1-2-2-3-2-2-2\" data-name=\"copy address button text\" data-reason=\"text replaced to 'Dirección copiada' after copy success\">\n                                        Guardar dirección\n                                    </span>\n                                </button>\n                            </div>\n                            <div class=\"mt-7 grid grid-cols-2 gap-x-10 gap-y-4\" data-kid=\"1-2-3-1-2-2-3-3\">\n                                <p class=\"mono m-0 text-[12px] uppercase tracking-[.07em]\" data-kid=\"1-2-3-1-2-2-3-3-1\">\n                                    <span class=\"mr-2 text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-3-1-1\">\n                                        •\n                                    </span>\n                                    Comer en el local\n                                </p>\n                                <p class=\"mono m-0 text-[12px] uppercase tracking-[.07em]\" data-kid=\"1-2-3-1-2-2-3-3-2\">\n                                    <span class=\"mr-2 text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-3-2-1\">\n                                        •\n                                    </span>\n                                    Para llevar\n                                </p>\n                                <p class=\"mono m-0 text-[12px] uppercase tracking-[.07em]\" data-kid=\"1-2-3-1-2-2-3-3-3\">\n                                    <span class=\"mr-2 text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-3-3-1\">\n                                        •\n                                    </span>\n                                    Entrega a domicilio\n                                </p>\n                                <p class=\"mono m-0 text-[12px] uppercase tracking-[.07em]\" data-kid=\"1-2-3-1-2-2-3-3-4\">\n                                    <span class=\"mr-2 text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-3-4-1\">\n                                        •\n                                    </span>\n                                    Terraza\n                                </p>\n                                <p class=\"mono col-span-2 m-0 text-[12px] uppercase tracking-[.07em]\" data-kid=\"1-2-3-1-2-2-3-3-5\">\n                                    <i class=\"ti ti-accessible mr-2 text-[15px] text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-3-5-1\">\n                                    </i>\n                                    Entrada accesible\n                                </p>\n                            </div>\n                            <a class=\"mono mt-8 inline-flex items-center gap-3 text-[12px] font-semibold uppercase tracking-[.1em] text-[var(--ink)] no-underline transition-colors hover:text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-4\" href=\"tel:+34966344188\">\n                                <i class=\"ti ti-phone text-[17px] text-[var(--harissa)]\" data-kid=\"1-2-3-1-2-2-3-4-1\">\n                                </i>\n                                +34 966 34 41 88\n                            </a>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </section>\n    </main>\n    <footer class=\"relative overflow-hidden bg-[var(--ink-deep)] px-7 py-16 text-[var(--paper)] lg:px-10 lg:py-20\" data-kid=\"1-3\">\n        <div class=\"pointer-events-none absolute right-0 top-0 h-full w-[16%] border-l border-[var(--paper)]/[.08] bg-[var(--paper)]/[.035]\" data-kid=\"1-3-1\">\n        </div>\n        <div class=\"footer-grid relative mx-auto grid max-w-[1280px] grid-cols-[1.1fr_.8fr_1.15fr] gap-12\" data-kid=\"1-3-2\">\n            <div data-kid=\"1-3-2-1\">\n                <p class=\"display m-0 text-[52px] font-extrabold uppercase leading-[.75] tracking-[-.02em]\" data-kid=\"1-3-2-1-1\">\n                    KEBAB\n                    <br data-kid=\"1-3-2-1-1-1\"/>\n                    <span class=\"text-[var(--harissa)]\" data-kid=\"1-3-2-1-1-2\">\n                        SUFI\n                    </span>\n                </p>\n                <p class=\"ui mt-7 max-w-[270px] text-[14px] leading-6 text-[var(--paper)]/65\" data-kid=\"1-3-2-1-2\">\n                    Comer aquí, para llevar o a domicilio. El sabor de Orihuela hasta tarde.\n                </p>\n                <div class=\"mt-7 flex flex-wrap gap-3\" data-kid=\"1-3-2-1-3\">\n                    <a class=\"mono border border-[var(--paper)]/25 px-4 py-2 text-[10px] uppercase tracking-[.14em] text-[var(--paper)] no-underline transition-colors hover:border-[var(--harissa)] hover:text-[var(--harissa)]\" data-kid=\"1-3-2-1-3-1\" href=\"https://www.instagram.com/pak_orihuela_kebab/\" rel=\"noreferrer\" target=\"_blank\">\n                        Instagram\n                    </a>\n                    <a class=\"mono border border-[var(--paper)]/25 px-4 py-2 text-[10px] uppercase tracking-[.14em] text-[var(--paper)] no-underline transition-colors hover:border-[var(--harissa)] hover:text-[var(--harissa)]\" data-kid=\"1-3-2-1-3-2\" href=\"tel:+34966344188\">\n                        966 34 41 88\n                    </a>\n                </div>\n            </div>\n            <div data-kid=\"1-3-2-2\">\n                <p class=\"mono mb-7 text-[10px] font-semibold uppercase tracking-[.22em] text-[var(--paper)]/42\" data-kid=\"1-3-2-2-1\">\n                    Datos rápidos\n                </p>\n                <div class=\"grid gap-4 mono text-[12px] uppercase tracking-[.08em] text-[var(--paper)]/76\" data-kid=\"1-3-2-2-2\">\n                    <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-3-2-2-2-1\" href=\"#selection\">\n                        Qué preparamos\n                    </a>\n                    <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-3-2-2-2-2\" href=\"#horario\">\n                        Horario\n                    </a>\n                    <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-3-2-2-2-3\" href=\"#local\">\n                        Dirección\n                    </a>\n                    <a class=\"no-underline hover:text-[var(--paper)]\" data-kid=\"1-3-2-2-2-4\" href=\"#local\">\n                        Entrada accesible\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative z-10 border-l border-[var(--paper)]/15 pl-8 lg:pl-12\" data-kid=\"1-3-2-3\">\n                <p class=\"mono mb-4 text-[10px] font-semibold uppercase tracking-[.22em] text-[var(--harissa)]\" data-kid=\"1-3-2-3-1\">\n                    Orihuela · Vega Baja\n                </p>\n                <p class=\"display m-0 max-w-[430px] text-[56px] font-extrabold uppercase leading-[.82] tracking-[-.02em]\" data-kid=\"1-3-2-3-2\">\n                    C. Duque de Tamames, 20.\n                </p>\n                <a class=\"ui mt-8 inline-flex items-center gap-3 bg-[var(--harissa)] px-6 py-4 text-[12px] font-bold uppercase tracking-[.1em] text-[var(--paper)] no-underline transition-colors hover:bg-[var(--paper)] hover:text-[var(--ink-deep)]\" data-kid=\"1-3-2-3-3\" href=\"https://www.google.com/maps/search/?api=1&query=C.+Duque+de+Tamames+20,+Orihuela\" rel=\"noreferrer\" target=\"_blank\">\n                    Abrir indicaciones\n                    <i class=\"ti ti-arrow-up-right text-[17px]\" data-kid=\"1-3-2-3-3-1\">\n                    </i>\n                </a>\n            </div>\n        </div>\n        <div class=\"relative mx-auto mt-16 flex max-w-[1280px] items-center justify-between border-t border-[var(--paper)]/15 pt-5 mono text-[10px] uppercase tracking-[.1em] text-[var(--paper)]/42\" data-kid=\"1-3-3\">\n            <span data-kid=\"1-3-3-1\">\n                +34 966 34 41 88\n            </span>\n            <span data-kid=\"1-3-3-2\">\n                Orihuela · Kebab Sufi\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    (() => {\n    const toggle = document.getElementById('selection-toggle');\n    const panel = document.getElementById('selection-panel');\n    if (toggle && panel) toggle.addEventListener('click', () => {\n      const open = panel.classList.toggle('is-open');\n      toggle.setAttribute('aria-expanded', String(open));\n      panel.setAttribute('aria-hidden', String(!open));\n      toggle.textContent = open ? 'Ocultar detalles −' : 'Ver detalles +';\n    });\n    const copy = document.getElementById('copy-address');\n    if (copy) copy.addEventListener('click', async () => {\n      const address = 'C. Duque de Tamames, 20, 03300 Orihuela, Alicante';\n      try {\n        await navigator.clipboard.writeText(address);\n        copy.innerHTML = '<i class=\"ti ti-check text-[15px]\"></i><span>Dirección copiada</span>';\n      } catch {\n        copy.innerHTML = '<i class=\"ti ti-copy text-[15px]\"></i><span>Selecciona la dirección</span>';\n      }\n      window.setTimeout(() => { copy.innerHTML = '<i class=\"ti ti-copy text-[15px]\"></i><span>Guardar dirección</span>'; }, 2400);\n    });\n  })();\n</script>\n",
